<!-- 编码规范见 docs/CodeConventions.md -->
<Application x:Class="RailWeldApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RailWeldApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--
                    合并顺序：
                    1. 色值（Primitives.xaml）
                    2. 颜色画刷（Global / Controls / Pages）
                    3. 转换器、字体
                    4. 控件模板与样式（它们按 StaticResource 引用颜色画刷）
 -->

                <ResourceDictionary Source="/Assets/Colors/Primitives.xaml" />

                <ResourceDictionary Source="/Assets/Colors/Global/Surfaces.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Global/Text.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Global/Accent.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Global/Gradients.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Controls/NavigationButton.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/Login.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminShell.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminHome.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminRealTimeData.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminManualControl.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminAutoControl.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminTempMonitor.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminHistoryQuery.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminFaultAlarm.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminReportExport.xaml" />
                <ResourceDictionary Source="/Assets/Colors/Pages/AdminSettings.xaml" />

                <ResourceDictionary Source="/Styles/Tokens.xaml" />

                <ResourceDictionary Source="/Assets/Converters/AppConverters.xaml" />
                <ResourceDictionary Source="/Assets/FontFamilies/FontFamilies.xaml" />
                <ResourceDictionary Source="/Assets/Images/ImageResources.xaml" />

                <ResourceDictionary Source="/Themes/NavigationButton.xaml" />
                <ResourceDictionary Source="/Themes/DrawerControl.xaml" />
                <ResourceDictionary Source="/Themes/ViewTemplates.xaml" />
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Styles/CheckBoxStyle.xaml" />
                <ResourceDictionary Source="/Styles/TextBoxStyle.xaml" />
                <ResourceDictionary Source="/Styles/DatePickerStyle.xaml" />
                <ResourceDictionary Source="/Styles/PasswordBoxStyle.xaml" />
                <ResourceDictionary Source="/Styles/TextBlockStyle.xaml" />
                <ResourceDictionary Source="/Styles/ScrollBarStyle.xaml" />

                <ResourceDictionary Source="/Styles/Pages/LoginViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminDashboardViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AccountPanelViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminRealTimeDataViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminManualControlViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminAutoControlViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminTempMonitorViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminHistoryQueryViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminFaultAlarmViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminReportExportViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/Pages/AdminSettingsViewStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

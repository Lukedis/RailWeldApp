<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        页面：管理台外壳（AdminView）与首页（AdminDashboardView）
        顶部导航（无侧栏）+ 首页大图 + 产品能力卡片。
        色值仍来自 Primitives.xaml，页面只声明用途画刷。
    -->

    <!-- 顶部导航 -->
    <SolidColorBrush x:Key="AdminNavTextBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="AdminNavActiveBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="AdminNavBorderBrush" Color="{StaticResource LineDivider}" />
    <SolidColorBrush x:Key="AdminNavSurfaceBrush" Color="{StaticResource SurfaceCard}" />

    <!-- 采集状态胶囊 -->
    <SolidColorBrush x:Key="AdminStatusPillSurfaceBrush" Color="{StaticResource SurfaceSubtle}" />
    <SolidColorBrush x:Key="AdminStatusPillBorderBrush" Color="{StaticResource LineDivider}" />
    <SolidColorBrush x:Key="AdminStatusTextBrush" Color="{StaticResource InkSecondary}" />
    <SolidColorBrush x:Key="AdminStatusOnlineBrush" Color="{StaticResource SuccessDot}" />
    <SolidColorBrush x:Key="AdminStatusOfflineBrush" Color="{StaticResource InkTertiary}" />

    <!-- 首页大图：左深右透的横向遮罩，保证白色标题可读 -->

    <!-- 顶部压暗：让大图和白色导航之间过渡干净 -->

    <!--
        总览页首屏：白底 + 蓝线技术插画（与参考稿的视觉语言一致，不铺渐变背景）。
    -->

    <!-- 插画背后的蓝色光晕 -->
    <RadialGradientBrush x:Key="DashHeroGlowBrush"
                         Center="0.62,0.42"
                         GradientOrigin="0.62,0.42"
                         RadiusX="0.55"
                         RadiusY="0.55">
        <GradientStop Color="#662563EB" Offset="0" />
        <GradientStop Color="#002563EB" Offset="1" />
    </RadialGradientBrush>

    <!-- 技术插画线条 -->
    <SolidColorBrush x:Key="DashBlueprintBrush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="DashBlueprintDeepBrush" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="DashBlueprintSoftBrush" Color="#552563EB" />
    <SolidColorBrush x:Key="DashBlueprintFaintBrush" Color="#222563EB" />

    <SolidColorBrush x:Key="AdminHeroPrimaryButtonBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="AdminHeroPrimaryButtonTextBrush" Color="{StaticResource SurfaceCard}" />
    <SolidColorBrush x:Key="AdminHeroGhostBorderBrush" Color="{StaticResource LineBorderStrong}" />
    <SolidColorBrush x:Key="AdminHeroGhostHoverBrush" Color="{StaticResource SurfaceMuted}" />

    <!-- 近黑按钮（顶部“返回登录”） -->
    <SolidColorBrush x:Key="AdminCtaSurfaceBrush" Color="{StaticResource InkPrimary}" />
    <SolidColorBrush x:Key="AdminCtaHoverBrush" Color="{StaticResource InkStrong}" />
    <!-- 能力卡片 -->
    <SolidColorBrush x:Key="AdminCardSurfaceBrush" Color="{StaticResource SurfaceCard}" />
    <SolidColorBrush x:Key="AdminCardBorderBrush" Color="{StaticResource LineBorder}" />
    <SolidColorBrush x:Key="AdminCardIconSurfaceBrush" Color="{StaticResource SurfaceMuted}" />
    <SolidColorBrush x:Key="AdminCardIconBrush" Color="{StaticResource InkStrong}" />

</ResourceDictionary>

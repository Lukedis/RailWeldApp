<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties">

    <!--
        密码框样式（macOS 27 语言）
        视觉与 TextBoxStyle 完全一致：白底、1px 发丝描边、圆角 6、外部 3px 焦点环。
        PasswordBox 的 Password 属性带 [Browsable(false)]，不能直接写进模板 Trigger，
        所以占位提示由附加属性 PassWordBoxHelper.IsEmpty 驱动。
    -->

    <Style x:Key="PasswordBoxStyle" TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="{StaticResource ControlHeightMd}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="helper:CornerRadiusHelper.CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Grid>

                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FieldIcon"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:PassWordBoxHelper.IconText)}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Margin" Value="10,0,6,0" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Grid.Column="1">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="10,0,10,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />

                                    <TextBlock x:Name="FieldPlaceholder"
                                               Margin="10,0,10,0"
                                               VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                               IsHitTestVisible="False"
                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:PassWordBoxHelper.Placeholder)}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:PassWordBoxHelper.IsEmpty)}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="FieldIcon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  大号密码框（登录页，44 高，圆角矩形 RadiusMd）  -->
    <Style x:Key="LargePasswordBoxStyle"
           BasedOn="{StaticResource PasswordBoxStyle}"
           TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="{StaticResource ControlHeight2Xl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="helper:CornerRadiusHelper.CornerRadius" Value="{StaticResource RadiusSm}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PasswordVisibilityToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightSm}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBackground"
                            Background="Transparent"
                            CornerRadius="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfConverter}}">
                        <Grid Width="18" Height="18">
                            <Path x:Name="EyeOpen"
                                  Data="M1,9 C4.6,3.6 13.4,3.6 17,9 C13.4,14.4 4.6,14.4 1,9 Z M9,6.4 A2.6,2.6 0 1 1 9,11.6 A2.6,2.6 0 1 1 9,6.4 Z"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextTertiaryBrush}"
                                  StrokeThickness="1.2" />
                            <Path x:Name="EyeClosed"
                                  Data="M1,9 C4.6,3.6 13.4,3.6 17,9 C13.4,14.4 4.6,14.4 1,9 Z M2,1 L16,17"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextTertiaryBrush}"
                                  StrokeThickness="1.2"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="EyeOpen" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EyeClosed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBackground" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

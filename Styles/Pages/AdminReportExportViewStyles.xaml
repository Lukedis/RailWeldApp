<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties">

    <!--
        页面：报告导出（AdminReportExportView）专属样式
        左侧焊缝列表、右侧报告纸张（纸张就是打印源，后端直接打印这块可视元素）。
    -->

    <Style x:Key="ReportCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="{StaticResource ReportCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ReportCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <Style x:Key="ReportTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ReportHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource ReportMutedBrush}" />
    </Style>

    <!--  焊缝列表  -->
    <Style x:Key="ReportRowStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Row" Background="Transparent">
                        <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ReportHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ReportHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReportListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ReportRowStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingStackPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <Style x:Key="ReportHeaderStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="ReportHeaderRightStyle"
           BasedOn="{StaticResource ReportHeaderStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="ReportCellStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ReportCellRightStyle"
           BasedOn="{StaticResource ReportCellStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
    </Style>

    <Style x:Key="ReportResultStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Text" Value="● 合格" />
        <Setter Property="Foreground" Value="{StaticResource ReportOkBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                <Setter Property="Text" Value="● 超限" />
                <Setter Property="Foreground" Value="{StaticResource ReportAlarmBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  报告纸张  -->
    <Style x:Key="ReportPaperStyle" TargetType="Border">
        <Setter Property="Width" Value="520" />
        <Setter Property="Padding" Value="24,16" />
        <Setter Property="Background" Value="{StaticResource ReportPaperSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ReportPaperBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style x:Key="ReportPaperTitleStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ReportPaperSubtitleStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource ReportMutedBrush}" />
    </Style>

    <Style x:Key="ReportPaperLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource ReportMutedBrush}" />
    </Style>

    <Style x:Key="ReportPaperValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ReportPaperSectionStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ReportPaperTableHeaderStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="ReportPaperTableHeaderRightStyle"
           BasedOn="{StaticResource ReportPaperTableHeaderStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="ReportPaperCellStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ReportPaperCellRightStyle"
           BasedOn="{StaticResource ReportPaperCellStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
    </Style>

    <Style x:Key="ReportPaperOverStyle"
           BasedOn="{StaticResource ReportPaperCellRightStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ReportMutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasOverLimit}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ReportAlarmBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  纸张内状态字段  -->
    <Style x:Key="ReportQualifiedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource ReportOkBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsQualified, FallbackValue=True}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ReportAlarmBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReportQualifiedBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}" />
        <Setter Property="Background" Value="{StaticResource ReportOkSoftBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsQualified, FallbackValue=True}" Value="False">
                <Setter Property="Background" Value="{StaticResource ReportAlarmSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  操作按钮  -->
    <Style x:Key="ReportActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource ReportCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ReportCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Fill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource ReportHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReportPrimaryButtonStyle"
           BasedOn="{StaticResource AccentButton}"
           TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>
</ResourceDictionary>

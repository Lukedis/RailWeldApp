<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        页面：历史查询（AdminHistoryQueryView）专属样式
        卡片、焊缝列表、统计表与峰值条。全部为静态绘制，页面没有定时刷新。
    -->

    <Style x:Key="HistoryCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="{StaticResource HistoryCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HistoryCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <Style x:Key="HistoryTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="HistoryHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource HistoryMutedBrush}" />
    </Style>

    <!-- 表头 / 单元格 -->
    <Style x:Key="HistoryHeaderStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="HistoryHeaderRightStyle"
           BasedOn="{StaticResource HistoryHeaderStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="HistoryCellStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="HistoryCellRightStyle"
           BasedOn="{StaticResource HistoryCellStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
    </Style>

    <Style x:Key="HistoryMetricNameStyle"
           BasedOn="{StaticResource HistoryCellStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 结果标记：● 正常 / ● 超限 -->
    <Style x:Key="HistoryStatusStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Text" Value="● 正常" />
        <Setter Property="Foreground" Value="{StaticResource HistoryOkBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource HistoryAlarmBrush}" />
                <Setter Property="Text" Value="● 超限" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 右侧摘要里的判定（绑到 SelectedWeld） -->
    <Style x:Key="HistorySummaryStatusStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Text" Value="● 正常" />
        <Setter Property="Foreground" Value="{StaticResource HistoryOkBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedWeld.IsAbnormal, FallbackValue=False}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource HistoryAlarmBrush}" />
                <Setter Property="Text" Value="● 超限" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedWeld}" Value="{x:Null}">
                <Setter Property="Foreground" Value="{StaticResource HistoryMutedBrush}" />
                <Setter Property="Text" Value="● 未选择" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 超限次数：大于 0 变红 -->
    <Style x:Key="HistoryOverCountStyle"
           BasedOn="{StaticResource HistoryCellRightStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HistoryMutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasOverLimit}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource HistoryAlarmBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 峰值条：一次性绘制，不参与刷新 -->
    <Style x:Key="HistoryBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Background" Value="{StaticResource HistoryBarTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HistoryBarFillBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasOverLimit}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource HistoryAlarmBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 焊缝列表 -->
    <Style x:Key="HistoryRowStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Row" Background="Transparent">
                        <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HistoryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HistoryHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HistoryListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HistoryRowStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingStackPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <Style x:Key="HistorySampleListStyle"
           BasedOn="{StaticResource HistoryListStyle}"
           TargetType="{x:Type ListBox}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>

    <!-- 日期选择 -->


    <!-- 空列表提示 -->
    <Style x:Key="HistoryEmptyStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource HistoryMutedBrush}" />
        <Setter Property="Text" Value="这一天还没有记录" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasResults, FallbackValue=False}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

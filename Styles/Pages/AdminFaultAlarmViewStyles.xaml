<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties">

    <!--
        页面：故障报警（AdminFaultAlarmView）专属样式
        顶部状态条、报警列表、统计卡与两个操作按钮。全部静态绘制，无定时刷新。
    -->

    <Style x:Key="AlarmCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="{StaticResource AlarmCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AlarmCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <Style x:Key="AlarmTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AlarmHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource AlarmMutedBrush}" />
    </Style>

    <Style x:Key="AlarmBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AlarmStatValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!--  顶部状态条：采集中断为琥珀色，连接正常且无报警为绿色，有活动报警为红色  -->
    <Style x:Key="AlarmBannerStyle" TargetType="Border">
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="{StaticResource AlarmOkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AlarmCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlcConnected, FallbackValue=False}" Value="False">
                <Setter Property="Background" Value="{StaticResource AlarmWarnSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlarmWarnBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasActiveAlarm, FallbackValue=False}" Value="True" />
                    <Condition Binding="{Binding IsPlcConnected, FallbackValue=False}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource AlarmDangerSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlarmDangerSoftInkBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AlarmBannerDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill" Value="{StaticResource AlarmOkBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlcConnected, FallbackValue=False}" Value="False">
                <Setter Property="Fill" Value="{StaticResource AlarmWarnBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasActiveAlarm, FallbackValue=False}" Value="True" />
                    <Condition Binding="{Binding IsPlcConnected, FallbackValue=False}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{StaticResource AlarmDangerBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AlarmBannerTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Text" Value="系统正常 · 暂无活动报警" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlcConnected, FallbackValue=False}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource AlarmWarnInkBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasActiveAlarm, FallbackValue=False}" Value="True" />
                    <Condition Binding="{Binding IsPlcConnected, FallbackValue=False}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource AlarmDangerInkBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--  级别：故障红 / 警告橙 / 提示灰  -->
    <Style x:Key="AlarmLevelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Text" Value="● 提示" />
        <Setter Property="Foreground" Value="{StaticResource AlarmMutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LevelText}" Value="故障">
                <Setter Property="Text" Value="● 故障" />
                <Setter Property="Foreground" Value="{StaticResource AlarmDangerBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LevelText}" Value="警告">
                <Setter Property="Text" Value="● 警告" />
                <Setter Property="Foreground" Value="{StaticResource AlarmWarnBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  状态：活动 / 已恢复  -->
    <Style x:Key="AlarmStateStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Text" Value="○ 已恢复" />
        <Setter Property="Foreground" Value="{StaticResource AlarmMutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Text" Value="● 活动" />
                <Setter Property="Foreground" Value="{StaticResource AlarmDangerBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  表头 / 单元格  -->
    <Style x:Key="AlarmHeaderStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AlarmHeaderRightStyle"
           BasedOn="{StaticResource AlarmHeaderStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="AlarmCellStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AlarmTimeStyle"
           BasedOn="{StaticResource AlarmCellStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AlarmCodeStyle"
           BasedOn="{StaticResource AlarmCellStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!--  报警列表  -->
    <Style x:Key="AlarmRowStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Row" Background="Transparent">
                        <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AlarmHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AlarmHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AlarmListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AlarmRowStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingStackPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <!--  操作按钮  -->
    <Style x:Key="AlarmActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource AlarmActionSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AlarmActionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Fill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource AlarmHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AlarmDangerButtonStyle"
           BasedOn="{StaticResource AlarmActionButtonStyle}"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource AlarmDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AlarmDangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AlarmOnDangerBrush}" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!--  筛选下拉  -->
    <Style x:Key="AlarmFilterStyle"
           BasedOn="{StaticResource AutoComboBoxStyle}"
           TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>
</ResourceDictionary>

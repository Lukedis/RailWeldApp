<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties">

    <!--
        页面：登录页（LoginView）专属样式
        左：白底登录表单    右：点阵插画面板（标语 + 手机实拍图 + 采集状态）
        通用控件样式仍来自 Styles/ButtonStyle.xaml、TextBoxStyle.xaml 等。
    -->

    <!--  品牌行  -->

    <Style x:Key="LoginBrandMarkStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{StaticResource LoginPrimarySurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style x:Key="LoginBrandMarkTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="Text" Value="R" />
    </Style>

    <Style x:Key="LoginBrandNameStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Text" Value="RailWeld" />
    </Style>

    <!--  标题与说明  -->

    <Style x:Key="LoginTitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,34,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="LoginSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!--  表单字段  -->

    <Style x:Key="LoginFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,0,0,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="LoginFieldLabelGapStyle"
           BasedOn="{StaticResource LoginFieldLabelStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="2,18,0,6" />
    </Style>

    <!--
        输入框：浅灰底 + 淡描边。
        只换底与描边，模板、焦点态、占位提示都沿用全局的大号输入框样式。
    -->
    <Style x:Key="LoginTextBoxStyle"
           BasedOn="{StaticResource LargeTextBoxStyle}"
           TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style x:Key="LoginPasswordBoxStyle"
           BasedOn="{StaticResource LargePasswordBoxStyle}"
           TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style x:Key="LoginPlainPasswordTextBoxStyle"
           BasedOn="{StaticResource LargePlainPasswordTextBoxStyle}"
           TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <!--
        主按钮：近黑实心 + 白字，和截图里的 Sign in 一致。
        焦点环画在外侧，不挤压内容；禁用时只降透明度，不改变颜色。
    -->
    <Style x:Key="LoginPrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource ControlHeight2Xl}" />
        <Setter Property="Background" Value="{StaticResource LoginPrimarySurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="ButtonFill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusLg}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonFill" Property="Background" Value="{StaticResource LoginPrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonFill" Property="Background" Value="{StaticResource LoginPrimaryPressBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonFill" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  次要登录方式：白底 + 1px 描边  -->
    <Style x:Key="LoginSocialButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource ControlHeight2Xl}" />
        <Setter Property="Background" Value="{StaticResource LoginSocialSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LoginSocialBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="ButtonFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusLg}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonFill" Property="Background" Value="{StaticResource LoginSocialHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonFill" Property="Background" Value="{StaticResource LoginSocialPressBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonFill" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  “或”分隔线  -->
    <Style x:Key="LoginDividerTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="Text" Value="或" />
    </Style>

    <!--  底部署名与页脚  -->
    <Style x:Key="LoginFooterTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!--
        右侧插画面板
        标语两行，行高按字号收紧；点阵底纹与手机图都是静态内容，
        不放任何 Effect（阴影/模糊会强制软件渲染）。
    -->
    <Style x:Key="LoginHeroHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
        <Setter Property="LineHeight" Value="46" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LoginHeroSublineStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="LoginStatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{StaticResource LoginStatusSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LoginStatusBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <Style x:Key="LoginStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource LoginOfflineBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Plc.IsConnected}" Value="True">
                <Setter Property="Fill" Value="{StaticResource LoginOnlineBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoginStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource LoginStatusTextBrush}" />
        <Setter Property="Text" Value="采集服务离线" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Plc.IsConnected}" Value="True">
                <Setter Property="Text" Value="采集服务在线" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  错误 / 提示条：默认折叠，不占布局  -->
    <Style x:Key="LoginErrorBannerStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Background" Value="{StaticResource LoginErrorSurfaceBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <!--<Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>-->
    </Style>

    <Style x:Key="LoginNoticeBannerStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Background" Value="{StaticResource AccentTint50Brush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasNotice}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties">

    <!--
        输入框样式（macOS 27 语言）
        · 白底 + 1px 发丝描边（#D1D1D6）+ 圆角 6，高度 32；
        · 聚焦时在控件外侧画 3px 半透明蓝色焦点环，边框本身不变；
        · 左侧图标列用 Auto：没设置图标时整列自动收起，不留空白；
        · 占位提示与真实文字同一基线（Padding 必须为 0，原因见下）。
    -->

    <Style x:Key="TextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource ControlHeightMd}" />
        <!--
            这里必须是 0：TextBox.Padding 会被应用在 PART_ContentHost 内部，
            只有真实文字会右移，占位提示（普通 TextBlock）不会，导致两者起点错开。
        -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentTint200Brush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="helper:CornerRadiusHelper.CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>

                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧图标：没有设置 IconText 时整列自动收起  -->
                                <TextBlock x:Name="FieldIcon"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:TextBoxHelper.IconText)}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Margin" Value="10,0,6,0" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Grid.Column="1">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="10,0,10,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />

                                    <TextBlock x:Name="FieldPlaceholder"
                                               Margin="10,0,10,0"
                                               VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                               IsHitTestVisible="False"
                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:TextBoxHelper.Placeholder)}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="FieldIcon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        大号输入框（登录页，44 高）。
        圆角用 RadiusMd（8），和截图里 Label 芯片的"圆角矩形"一致，不是胶囊。
    -->
    <Style x:Key="LargeTextBoxStyle"
           BasedOn="{StaticResource TextBoxStyle}"
           TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource ControlHeight2Xl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="helper:CornerRadiusHelper.CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style x:Key="LargePlainPasswordTextBoxStyle"
           BasedOn="{StaticResource LargeTextBoxStyle}"
           TargetType="{x:Type TextBox}" />
</ResourceDictionary>

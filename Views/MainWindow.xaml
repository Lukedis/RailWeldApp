<Window x:Class="RailWeldApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:design="clr-namespace:RailWeldApp.Design"
        xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RailWeld"
        Width="1600"
        Height="900"
        d:DataContext="{x:Static design:DesignData.MainWindowViewModel}"
        AllowsTransparency="False"
        Background="{StaticResource SurfaceCanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">

    <!--
        主窗口（自定义标题栏）
        1. WindowStyle=None + WindowChrome：去掉系统标题栏，但保留系统级
        阴影 / 圆角 / 拖拽命中测试，同时不开 AllowsTransparency
        （开启它会强制软件渲染，帧耗时从 ~6ms 涨到 ~160ms）。
        2. 自绘标题栏：左侧应用名，右侧最小化 / 关闭按钮。
        3. 所有圆角统一 16px（Radius2Xl）。
    -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource SurfaceCanvasBrush}"
            ClipToBounds="True"
            CornerRadius="8">
        <Grid RowDefinitions="0,*">

            <Grid Grid.Row="0"
                  Height="0"
                  Visibility="Collapsed">

                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="18"
                            Height="18"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="{StaticResource RadiusXs}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UiFontSemibold}"
                                   FontSize="10"
                                   Foreground="{StaticResource OnAccentBrush}"
                                   Text="R" />
                    </Border>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFontSemibold}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="RailWeld" />
                </StackPanel>

                <!--  窗口按钮  -->
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Orientation="Horizontal">
                    <Button Width="44"
                            Height="32"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            Style="{StaticResource HeaderIconButton}"
                            ToolTip="最小化">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Text="&#xE921;" />
                    </Button>
                    <Button Width="44"
                            Height="32"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            Style="{StaticResource HeaderIconButton}"
                            ToolTip="关闭">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="ViewHost"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{Binding CurrentView}" />
        </Grid>
    </Border>
</Window>

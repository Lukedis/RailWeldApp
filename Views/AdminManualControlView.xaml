<UserControl x:Class="RailWeldApp.Views.AdminManualControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminManualControlViewModel}"
             d:DesignHeight="784"
             d:DesignWidth="1400"
             mc:Ignorable="d">

    <!--
        手动控制（纯前端）
        上：轴运动实时反馈（点动时看目标 / 实际是否对上）
        中：8 张控制卡，4×2 排列 —— 电源 / 喷风 / Y 轴 / Z 轴 / 1#~4# 顶料气缸
        下：页脚状态条
        卡片行高用 *，窗口越高卡片越高；整页包一层 ScrollViewer，小屏时滚动而不是裁切。

        需要 VM（AdminManualControlViewModel）提供的成员：
        轴（double，与设备管理页同名）：
        XAxisActualPosition  XAxisActualSpeed  XAxisTargetPosition  XAxisTargetSpeed  XAxisCurrent
        （YAxis* / ZAxis* 同名）
        设定值（double）：PowerSetpoint（%）  TimeSetpoint（s）
        命令（ICommand，无参）：PowerOnCommand  PowerOffCommand
        AirBlowStartCommand  AirBlowStopCommand
        YAxisLeftCommand  YAxisRightCommand
        ZAxisUpCommand  ZAxisDownCommand
        Jack1UpCommand  Jack1DownCommand
        Jack2UpCommand  Jack2DownCommand
        Jack3UpCommand  Jack3DownCommand
        Jack4UpCommand  Jack4DownCommand
        页脚：AppVersion(string)  IsCommunicationOk(bool)  CommunicationDelayMs(int)  ClockText(string)
        绑定都带 FallbackValue，VM 没接好时显示 0.000 / 灰灯，不会报绑定错误。
    -->

    <UserControl.Resources>
        <!--  按钮图标：一个几何资源反复用，4 个方向 + 启停  -->
        <PathGeometry x:Key="ManualIconPlay" Figures="M5,3 L16,10 L5,17 Z" />
        <PathGeometry x:Key="ManualIconStop" Figures="M5,5 L15,5 L15,15 L5,15 Z" />
        <PathGeometry x:Key="ManualIconLeft" Figures="M12,4 L6,10 L12,16" />
        <PathGeometry x:Key="ManualIconRight" Figures="M8,4 L14,10 L8,16" />
        <PathGeometry x:Key="ManualIconUp" Figures="M4,12 L10,6 L16,12" />
        <PathGeometry x:Key="ManualIconDown" Figures="M4,8 L10,14 L16,8" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceCardBrush}" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="64,18,64,10"
                  MinHeight="720"
                  RowDefinitions="Auto,8,Auto,10,*">

                <!--  页头  -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AdminSectionKickerStyle}" Text="手动控制" />
                        <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                   FontSize="{StaticResource FontSizeDisplay}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="全自动钢轨焊接接头热处理设备" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="11,7"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource ManualWarningSurfaceBrush}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource ManualWarningDotBrush}" />
                            <TextBlock Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="手动模式 · 指令按下即下发" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  轴反馈  -->
                <Border Grid.Row="2" Style="{StaticResource ManualCardStyle}">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="轴运动" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource ManualCardHintStyle}"
                                       Text="点动时对照目标 / 实际值 · 刷新 200 ms" />
                        </Grid>

                        <Border Margin="0,8,0,0"
                                BorderBrush="{StaticResource ManualSeparatorBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Height="24" ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                <TextBlock Style="{StaticResource ManualTableHeaderStyle}" Text="轴名称" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ManualTableHeaderRightStyle}"
                                           Text="实际位置 (mm)" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource ManualTableHeaderRightStyle}"
                                           Text="实际速度 (mm/min)" />
                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource ManualTableHeaderRightStyle}"
                                           Text="目标位置 (mm)" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource ManualTableHeaderRightStyle}"
                                           Text="目标速度 (mm/min)" />
                                <TextBlock Grid.Column="5"
                                           Style="{StaticResource ManualTableHeaderRightStyle}"
                                           Text="实际电流 (A)" />
                            </Grid>
                        </Border>

                        <Border Height="30"
                                BorderBrush="{StaticResource ManualSeparatorBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                <TextBlock Style="{StaticResource ManualTableIndexStyle}" Text="X 轴（南北）" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding XAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding XAxisActualSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding XAxisTargetPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding XAxisTargetSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="5"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding XAxisCurrent, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                            </Grid>
                        </Border>

                        <Border Height="30"
                                BorderBrush="{StaticResource ManualSeparatorBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                <TextBlock Style="{StaticResource ManualTableIndexStyle}" Text="Y 轴（东西）" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding YAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding YAxisActualSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding YAxisTargetPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding YAxisTargetSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="5"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding YAxisCurrent, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                            </Grid>
                        </Border>

                        <Border Height="30">
                            <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                <TextBlock Style="{StaticResource ManualTableIndexStyle}" Text="Z 轴（上下）" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding ZAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding ZAxisActualSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding ZAxisTargetPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding ZAxisTargetSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <TextBlock Grid.Column="5"
                                           Style="{StaticResource ManualTableValueStyle}"
                                           Text="{Binding ZAxisCurrent, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  控制卡 4 × 2  -->
                <Grid Grid.Row="4"
                      ColumnDefinitions="*,16,*,16,*,16,*"
                      RowDefinitions="*,10,*">

                    <!--  电源控制  -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="电源控制" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="IGBT 感应加热电源" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="380 V · 300 A" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <TextBlock Style="{StaticResource ManualFieldLabelStyle}" Text="功率设定" />
                                    <TextBox Grid.Column="2"
                                             Style="{StaticResource ManualNumberBoxStyle}"
                                             Text="{Binding PowerSetpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="6,0,0,0"
                                               Style="{StaticResource ManualFieldUnitStyle}"
                                               Text="%" />
                                </Grid>
                                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
                                    <TextBlock Style="{StaticResource ManualFieldLabelStyle}" Text="时间设定" />
                                    <TextBox Grid.Column="2"
                                             Margin="0,0,3,0"
                                             Style="{StaticResource ManualNumberBoxStyle}"
                                             Text="{Binding TimeSetpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="6,0,0,0"
                                               Style="{StaticResource ManualFieldUnitStyle}"
                                               Text="S" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="上电前确认冷却水、气压与安全门状态。" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding PowerOnCommand}" Style="{StaticResource ManualRoundPrimaryButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconPlay}"
                                              Fill="{StaticResource OnAccentBrush}"
                                              Stretch="Uniform" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="通电" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding PowerOffCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="13"
                                              Height="13"
                                              Data="{StaticResource ManualIconStop}"
                                              Fill="{StaticResource TextPrimaryBrush}"
                                              Stretch="Uniform" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="断电" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  喷风控制  -->
                    <Border Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="喷风控制" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="焊后冷却与清渣" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="0.4–0.6 MPa" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="工作压力" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="0.4–0.6 MPa" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="吹扫时长" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="6 s" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="气压下限" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="0.4 MPa" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="气压低于下限时禁止启动，先检查气源。" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding AirBlowStartCommand}" Style="{StaticResource ManualRoundPrimaryButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconPlay}"
                                              Fill="{StaticResource OnAccentBrush}"
                                              Stretch="Uniform" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="启动" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding AirBlowStopCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="13"
                                              Height="13"
                                              Data="{StaticResource ManualIconStop}"
                                              Fill="{StaticResource TextPrimaryBrush}"
                                              Stretch="Uniform" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="停止" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Y 轴位移气缸  -->
                    <Border Grid.Row="0"
                            Grid.Column="4"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="Y 轴位移气缸" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="焊缝对中微调" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="±50 mm" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ManualSpecLabelStyle}" Text="实际位置" />
                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ManualPositionStyle}" Text="{Binding YAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Style="{StaticResource ManualPositionUnitStyle}" Text="mm" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="行程 ±50 mm · 速度 600 mm/min · 到位指示常亮" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding YAxisLeftCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconLeft}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="左移" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding YAxisRightCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconRight}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="右移" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Z 轴位移气缸  -->
                    <Border Grid.Row="0"
                            Grid.Column="6"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="Z 轴位移气缸" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="焊枪升降定位" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="0–300 mm" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ManualSpecLabelStyle}" Text="实际位置" />
                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ManualPositionStyle}" Text="{Binding ZAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Style="{StaticResource ManualPositionUnitStyle}" Text="mm" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="速度 300 mm/min · 升降前确认无干涉" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding ZAxisUpCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconUp}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="上升" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding ZAxisDownCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconDown}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="下降" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  1# 顶料气缸  -->
                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="1# 顶料气缸" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="轨底 1# 顶升" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="80 mm" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="行程" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="80 mm" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="顶升力" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="2.5 kN" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="安全位" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="落下检测" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="顶升到位后再允许焊接，落下前清空轨底。" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding Jack1UpCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconUp}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="上升" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding Jack1DownCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconDown}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="下降" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  2# 顶料气缸  -->
                    <Border Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="2# 顶料气缸" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="轨底 2# 顶升" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="80 mm" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="行程" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="80 mm" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="顶升力" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="2.5 kN" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="安全位" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="落下检测" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="四缸可单动，联调时按 1# → 4# 顺序顶升。" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding Jack2UpCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconUp}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="上升" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding Jack2DownCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconDown}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="下降" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  3# 顶料气缸  -->
                    <Border Grid.Row="2"
                            Grid.Column="4"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="3# 顶料气缸" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="轨底 3# 顶升" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="80 mm" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="行程" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="80 mm" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="顶升力" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="2.5 kN" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="安全位" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="落下检测" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="顶升过程中禁止伸入轨底区域。" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding Jack3UpCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconUp}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="上升" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding Jack3DownCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconDown}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="下降" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  4# 顶料气缸  -->
                    <Border Grid.Row="2"
                            Grid.Column="6"
                            Style="{StaticResource ManualCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ManualCardTitleStyle}" Text="4# 顶料气缸" />
                                    <TextBlock Style="{StaticResource ManualCardCaptionStyle}" Text="轨底 4# 顶升" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ManualChipStyle}">
                                    <TextBlock Style="{StaticResource ManualChipTextStyle}" Text="80 mm" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="1"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource ManualSeparatorBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="行程" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="80 mm" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="顶升力" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="2.5 kN" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource ManualStatLabelStyle}" Text="安全位" />
                                        <TextBlock Style="{StaticResource ManualStatValueStyle}" Text="落下检测" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource ManualCardHintStyle}"
                                           Text="四缸全部落下后，才允许输送轨料。" />
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <Button Command="{Binding Jack4UpCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconUp}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="上升" />
                                </StackPanel>
                                <StackPanel>
                                    <Button Command="{Binding Jack4DownCommand}" Style="{StaticResource ManualRoundButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource ManualIconDown}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </Button>
                                    <TextBlock Style="{StaticResource ManualButtonCaptionStyle}" Text="下降" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!--  页脚状态条  -->
        <Border Grid.Row="1"
                Height="46"
                BorderBrush="{StaticResource ManualSeparatorBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="64,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ManualFooterTextStyle}" Text="版本" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ManualFooterEmphasisStyle}"
                               Text="{Binding AppVersion, FallbackValue=—}" />
                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource ManualFooterTextStyle}"
                               Text="当前界面" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ManualFooterEmphasisStyle}"
                               Text="手动控制" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ManualFooterTextStyle}" Text="通讯状态" />
                    <Ellipse Width="7"
                             Height="7"
                             Margin="7,0,0,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ManualOfflineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommunicationOk, FallbackValue=False}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ManualOnlineBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource ManualFooterEmphasisStyle}" TargetType="TextBlock">
                                <Setter Property="Text" Value="中断" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommunicationOk, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="正常" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource ManualFooterTextStyle}"
                               Text="通讯延迟" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ManualFooterEmphasisStyle}"
                               Text="{Binding CommunicationDelayMs, StringFormat={}{0} ms, FallbackValue='0 ms'}" />

                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource ManualFooterTextStyle}"
                               Text="{Binding ClockText, FallbackValue=—}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

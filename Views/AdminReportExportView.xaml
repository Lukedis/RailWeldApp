<UserControl x:Class="RailWeldApp.Views.AdminReportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminReportExportViewModel}"
             d:DesignHeight="784"
             d:DesignWidth="1400"
             mc:Ignorable="d">

    <!--
        报告导出（纯前端）：左侧选焊缝，右侧「焊接接头热处理质量报告」纸张预览。
        预览纸张 `ReportPaper` 就是打印源 —— 后端用 PrintDialog.PrintVisual(ReportPaper, …)
        （先按 A4 比例缩放）即可打印或“打印到 PDF”，不需要再写一套排版。

        需要 VM（AdminReportExportViewModel）提供的成员：
        SelectedDate  (DateTime?)   顶部日期，TwoWay
        SearchText    (string)      编号搜索，TwoWay
        WeldItems     (集合)        待生成报告的焊缝（当天）
                                    WeldItem : SerialNumber(string)  TimeText(string)
                                               ResultText(string)  IsAbnormal(bool)
        SelectedWeld  (WeldItem?)   与列表 TwoWay，变化时重建 Report
        Report        (对象)       选中焊缝的报告数据（未选中时为 null，界面显示占位）

        Report 字段：
            SerialNumber  OperatorName  JobNumber  ProducedAt
            EquipmentName  RecipeName  ShiftName  LineName
            IsQualified(bool)  ResultText(string)  ResultDetail(string)
            ReportNo(string)   GeneratedAt(string)
            ProcessRows (集合: Section / TempText / PowerText / CoolingMode / CoolingParam)
            MetricRows  (集合: Name / Start / Peak / End / Average / MinText / MaxText
                              OverCount(int) / HasOverLimit(bool) / Judgement)

        PrintCommand / ExportPdfCommand  (命令)
        页脚：AppVersion(string)  IsCommunicationOk(bool)  CommunicationDelayMs(int)  ClockText(string)
    -->

    <Grid Background="{StaticResource SurfaceCardBrush}" RowDefinitions="*,Auto">

        <Grid Grid.Row="0" Margin="64,20,64,14" RowDefinitions="Auto,10,*,14,Auto">

            <!--  页头  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource AdminSectionKickerStyle}" Text="报告导出" />
                    <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                               FontSize="{StaticResource FontSizeDisplay}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="全自动钢轨焊接接头热处理设备" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                Style="{StaticResource DatePickerStyle}" />
                    <TextBox Width="200"
                             Margin="10,0,0,0"
                             Style="{StaticResource TextBoxStyle}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             helper:TextBoxHelper.Placeholder="搜索焊缝编号" />
                </StackPanel>
            </Grid>

            <!--  主体  -->
            <Grid Grid.Row="2" ColumnDefinitions="320,16,*">

                <!-- 左：待生成报告 -->
                <Border Style="{StaticResource ReportCardStyle}">
                    <Grid RowDefinitions="Auto,8,Auto,4,*">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Style="{StaticResource ReportTitleStyle}" Text="待生成报告" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource ReportHintStyle}"
                                       Text="{Binding WeldItems.Count, StringFormat={}{0} 条, FallbackValue='0 条'}" />
                        </Grid>

                        <Border Grid.Row="2"
                                Height="26"
                                Background="{StaticResource ReportHeaderBrush}"
                                CornerRadius="{StaticResource RadiusXs}">
                            <Grid Margin="12,0" ColumnDefinitions="*,84,64">
                                <TextBlock Style="{StaticResource ReportHeaderStyle}" Text="编号" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ReportHeaderRightStyle}" Text="时间" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ReportHeaderRightStyle}" Text="判定" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <ListBox ItemsSource="{Binding WeldItems}"
                                     SelectedItem="{Binding SelectedWeld, Mode=TwoWay}"
                                     Style="{StaticResource ReportListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,84,64">
                                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                                       Style="{StaticResource ReportCellStyle}"
                                                       Text="{Binding SerialNumber}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource ReportCellRightStyle}"
                                                       Text="{Binding TimeText}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ReportResultStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WeldItems.Count, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="24"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           Text="&#xE9D2;" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="今天还没有可导出的焊缝" />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="完成一次焊接后，报告会自动出现在这里" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右：报告预览 -->
                <Grid Grid.Column="2" RowDefinitions="Auto,10,*">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ReportTitleStyle}" Text="报告预览" />
                            <TextBlock Margin="10,0,0,0"
                                       Style="{StaticResource ReportHintStyle}"
                                       Text="{Binding Report.SerialNumber, StringFormat=A4 纵向 · 编号 {0}, FallbackValue='A4 纵向'}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding PrintCommand}"
                                    Content="打印"
                                    Style="{StaticResource ReportPrimaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding ExportPdfCommand}"
                                    Content="导出 PDF"
                                    Style="{StaticResource ReportActionButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- 纸张：打印源；Viewbox 只放大预览，不改变 ReportPaper 的排版尺寸 -->
                    <Viewbox Grid.Row="2"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Stretch="Uniform"
                             StretchDirection="UpOnly">
                        <Border x:Name="ReportPaper"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource ReportPaperStyle}">
                        <StackPanel>

                            <TextBlock Style="{StaticResource ReportPaperTitleStyle}" Text="焊接接头热处理质量报告" />
                            <TextBlock Style="{StaticResource ReportPaperSubtitleStyle}"
                                       Text="全自动钢轨焊接接头热处理设备 · 中频感应加热正火" />

                            <Border Height="1" Margin="0,12,0,0" Background="{StaticResource ReportSeparatorBrush}" />

                            <!-- 基本信息 -->
                            <Grid Margin="0,12,0,0" ColumnDefinitions="*,*" RowDefinitions="16,16,16,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="焊缝编号" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.SerialNumber, FallbackValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="操作员" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.OperatorName, FallbackValue='—'}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="工号" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.JobNumber, FallbackValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="生产日期" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.ProducedAt, FallbackValue='—'}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="设备编号" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.EquipmentName, FallbackValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="工艺配方" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.RecipeName, FallbackValue='—'}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="生产线 / 班次" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.ShiftName, FallbackValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="报告编号" />
                                    <TextBlock Style="{StaticResource ReportPaperValueStyle}" Text="{Binding Report.ReportNo, FallbackValue='—'}" />
                                </StackPanel>
                            </Grid>

                            <!-- 工艺参数 -->
                            <TextBlock Style="{StaticResource ReportPaperSectionStyle}" Text="工艺参数" />
                            <Border Height="22" Margin="0,6,0,0" Background="{StaticResource ReportHeaderBrush}" CornerRadius="{StaticResource RadiusXs}">
                                <Grid Margin="8,0" ColumnDefinitions="*,68,68,70,84">
                                    <TextBlock Style="{StaticResource ReportPaperTableHeaderStyle}" Text="程序段" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="温度 ℃" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="功率 %" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource ReportPaperTableHeaderStyle}" Text="冷却方式" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="冷却参数" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Report.ProcessRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="18" Margin="8,0" ColumnDefinitions="*,68,68,70,84">
                                            <TextBlock Style="{StaticResource ReportPaperCellStyle}" Text="{Binding Section}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding TempText}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding PowerText}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource ReportPaperCellStyle}" Text="{Binding CoolingMode}" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding CoolingParam}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 实测统计 -->
                            <TextBlock Style="{StaticResource ReportPaperSectionStyle}" Text="实测统计" />
                            <Border Height="22" Margin="0,6,0,0" Background="{StaticResource ReportHeaderBrush}" CornerRadius="{StaticResource RadiusXs}">
                                <Grid Margin="8,0" ColumnDefinitions="*,44,44,44,44,64,38,44">
                                    <TextBlock Style="{StaticResource ReportPaperTableHeaderStyle}" Text="指标" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="起始" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="峰值" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="末值" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="均值" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="上下限" />
                                    <TextBlock Grid.Column="6" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="超限" />
                                    <TextBlock Grid.Column="7" Style="{StaticResource ReportPaperTableHeaderRightStyle}" Text="判定" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Report.MetricRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="16" Margin="8,0" ColumnDefinitions="*,44,44,44,44,64,38,44">
                                            <TextBlock Style="{StaticResource ReportPaperCellStyle}" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding Start}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding Peak}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding End}" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding Average}" />
                                            <TextBlock Grid.Column="5" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding MinText}" />
                                            <TextBlock Grid.Column="6" Style="{StaticResource ReportPaperOverStyle}" Text="{Binding OverCount}" />
                                            <TextBlock Grid.Column="7" Style="{StaticResource ReportPaperCellRightStyle}" Text="{Binding Judgement}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 判定 -->
                            <TextBlock Style="{StaticResource ReportPaperSectionStyle}" Text="判定结论" />
                            <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*">
                                <Border Style="{StaticResource ReportQualifiedBadgeStyle}">
                                    <TextBlock Style="{StaticResource ReportQualifiedTextStyle}" Text="{Binding Report.ResultText, FallbackValue='待判定'}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Report.ResultDetail, FallbackValue='—'}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- 签字 -->
                            <Grid Margin="0,12,0,0" ColumnDefinitions="*,*,*">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="操作员签字" />
                                    <Border Height="1" Margin="0,16,16,0" Background="{StaticResource ReportSeparatorBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="质检员签字" />
                                    <Border Height="1" Margin="0,16,16,0" Background="{StaticResource ReportSeparatorBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource ReportPaperLabelStyle}" Text="日期" />
                                    <Border Height="1" Margin="0,16,0,0" Background="{StaticResource ReportSeparatorBrush}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Right"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource ReportMutedBrush}"
                                       Text="{Binding Report.GeneratedAt, FallbackValue='—'}" />
                        </StackPanel>
                    </Border>
                    </Viewbox>
                </Grid>
            </Grid>

            <!--  报告包含的内容：底部三卡  -->
            <Grid Grid.Row="4" ColumnDefinitions="*,16,*,16,*">
                <Border Padding="16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        CornerRadius="{StaticResource RadiusLg}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE9D9;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="工艺参数" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="三段温度 / 功率 / 冷却方式逐段记录" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        CornerRadius="{StaticResource RadiusLg}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE9D2;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="实测统计" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="起始 / 峰值 / 末值 / 均值与超限次数" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        CornerRadius="{StaticResource RadiusLg}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE945;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="判定结论" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="合格或超限，附复检建议与签字位" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1"
                Height="46"
                BorderBrush="{StaticResource ReportSeparatorBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="64,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ManualFooterTextStyle}" Text="版本" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ManualFooterEmphasisStyle}"
                               Text="{Binding AppVersion, FallbackValue=—}" />
                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource ManualFooterTextStyle}"
                               Text="当前界面" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ManualFooterEmphasisStyle}"
                               Text="报告导出" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ManualFooterTextStyle}" Text="通讯状态" />
                    <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ReportOfflineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommunicationOk, FallbackValue=False}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ReportOnlineBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource ManualFooterEmphasisStyle}" TargetType="TextBlock">
                                <Setter Property="Text" Value="中断" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommunicationOk, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="正常" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource ManualFooterTextStyle}"
                               Text="通讯延迟" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ManualFooterEmphasisStyle}"
                               Text="{Binding CommunicationDelayMs, StringFormat={}{0} ms, FallbackValue='0 ms'}" />

                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource ManualFooterTextStyle}"
                               Text="{Binding ClockText, FallbackValue=—}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="RailWeldApp.Views.AdminRealTimeDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:control="clr-namespace:RailWeldApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminRealTimeDataViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             mc:Ignorable="d">

    <!--
        实时数据：设备实时看板（纯前端）
        布局：页头（设备名 + 焊缝编号）→ 左列三张表（轴运动 / 传感器 / 执行机构）
        + 右列电参数（电压 / 电流 / 功率 / 能量，大数字 + 量程条）→ 页脚状态条

        需要 VM（AdminRealTimeDataViewModel）提供的属性：
        轴（double）：XAxisActualPosition   XAxisActualSpeed   XAxisTargetPosition
        XAxisTargetSpeed      XAxisCurrent        （YAxis* / ZAxis* 同名）
        传感器（double）：TempRailTop  TempRailFoot  TempRailInnerFoot  TempCooling
        FlowRailTop  FlowRailWeb  FlowRailBottom     FlowSpare
        TrackY       TrackZ       AirPressure        TrackSpare
        执行机构（bool）：IgbtPowerOn  YAxisInPosition  ZAxisInPosition  JackSafePosition
        AllowProcessing  FeedComplete  AutoRunning  SpareActuator
        电参数（double）：Voltage  Current  Power  Energy
        量程条直接用 Value / Maximum 算比例，Maximum 写死在 XAML 里
        （600 V / 400 A / 200 kW / 20000 kW·s），现场量程不同就改这四个数字
        注意：RangeBase.Value 默认 TwoWay，这里显式写了 Mode=OneWay，
        VM 用只读属性（只有 getter）也不会抛“无法对只读属性进行 TwoWay 绑定”
        页脚：AppVersion(string)  IsCommunicationOk(bool)  CommunicationDelayMs(int)
        ClockText(string)  WeldId(string)
        所有绑定都带 FallbackValue，VM 没接好时显示 0.000 / 灰灯，不会报绑定错误。
    -->

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0"
              Margin="64,20,64,14"
              RowDefinitions="Auto,14,*">

            <!--  页头  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource AdminSectionKickerStyle}" Text="实时数据" />
                    <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                               FontSize="{StaticResource FontSizeDisplay}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="全自动钢轨焊接接头热处理设备" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Border Padding="12,7"
                            Background="{StaticResource EquipTableHeaderBrush}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Text="焊缝编号" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding WeldId, FallbackValue=—}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="10,0,0,0"
                            Padding="12,7"
                            Background="{StaticResource EquipTableHeaderBrush}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Text="采样周期" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="200 ms" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!--  主体  -->
            <Grid Grid.Row="2" ColumnDefinitions="*,16,520">

                <!--  左列：三张表  -->
                <Grid Grid.Column="0" RowDefinitions="*,12,*,12,*">

                    <!--  轴运动  -->
                    <Border Grid.Row="0" Style="{StaticResource EquipCardStyle}">
                        <Grid RowDefinitions="Auto,Auto,*,*,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource EquipCardTitleStyle}" Text="轴运动" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource EquipCardHintStyle}"
                                           Text="三轴联动 · 实时" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,8,0,0"
                                    BorderBrush="{StaticResource EquipSeparatorBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Height="28" ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                    <TextBlock Style="{StaticResource EquipTableHeaderStyle}" Text="轴名称" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableHeaderRightStyle}"
                                               Text="实际位置 (mm)" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableHeaderRightStyle}"
                                               Text="实际速度 (mm/min)" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableHeaderRightStyle}"
                                               Text="目标位置 (mm)" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableHeaderRightStyle}"
                                               Text="目标速度 (mm/min)" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableHeaderRightStyle}"
                                               Text="实际电流 (A)" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    BorderBrush="{StaticResource EquipSeparatorBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                    <TextBlock Style="{StaticResource EquipTableIndexStyle}" Text="X 轴（南北）" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding XAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding XAxisActualSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding XAxisTargetPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding XAxisTargetSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding XAxisCurrent, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="3"
                                    BorderBrush="{StaticResource EquipSeparatorBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                    <TextBlock Style="{StaticResource EquipTableIndexStyle}" Text="Y 轴（东西）" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding YAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding YAxisActualSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding YAxisTargetPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding YAxisTargetSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding YAxisCurrent, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="4">
                                <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,0.9*">
                                    <TextBlock Style="{StaticResource EquipTableIndexStyle}" Text="Z 轴（上下）" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding ZAxisActualPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding ZAxisActualSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding ZAxisTargetPosition, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding ZAxisTargetSpeed, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding ZAxisCurrent, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  传感器矩阵  -->
                    <Border Grid.Row="2" Style="{StaticResource EquipCardStyle}">
                        <Grid RowDefinitions="Auto,12,Auto,*,*,*,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource EquipCardTitleStyle}" Text="设备传感器数据" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource EquipCardHintStyle}"
                                           Text="12 路模拟量" />
                            </Grid>

                            <!--  分组标题  -->
                            <Grid Grid.Row="2" ColumnDefinitions="1.25*,0.75*,1.25*,0.75*,1.15*,0.85*">
                                <Border Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource EquipGroupHeaderStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource EquipTableHeaderStyle}"
                                               Text="温度传感器" />
                                </Border>
                                <Border Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource EquipGroupHeaderStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource EquipTableHeaderStyle}"
                                               Text="流量传感器" />
                                </Border>
                                <Border Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource EquipGroupHeaderStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource EquipTableHeaderStyle}"
                                               Text="位移传感器" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="3"
                                    BorderBrush="{StaticResource EquipSeparatorBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.25*,0.75*,1.25*,0.75*,1.15*,0.85*">
                                    <TextBlock Style="{StaticResource EquipTableCellStyle}" Text="轨顶温度 (℃)" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding TempRailTop, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="轨顶流量 (L/min)" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding FlowRailTop, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="Y 轴跟踪 (mm)" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding TrackY, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="4"
                                    BorderBrush="{StaticResource EquipSeparatorBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.25*,0.75*,1.25*,0.75*,1.15*,0.85*">
                                    <TextBlock Style="{StaticResource EquipTableCellStyle}" Text="轨脚温度 (℃)" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding TempRailFoot, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="轨腰流量 (L/min)" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding FlowRailWeb, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="Z 轴跟踪 (mm)" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding TrackZ, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="5"
                                    BorderBrush="{StaticResource EquipSeparatorBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.25*,0.75*,1.25*,0.75*,1.15*,0.85*">
                                    <TextBlock Style="{StaticResource EquipTableCellStyle}" Text="内轨脚温度 (℃)" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding TempRailInnerFoot, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="轨底流量 (L/min)" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding FlowRailBottom, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="喷风压力 (MPa)" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding AirPressure, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="6">
                                <Grid ColumnDefinitions="1.25*,0.75*,1.25*,0.75*,1.15*,0.85*">
                                    <TextBlock Style="{StaticResource EquipTableCellStyle}" Text="冷却温度 (℃)" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding TempCooling, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="备用" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding FlowSpare, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource EquipTableCellStyle}"
                                               Text="备用" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource EquipTableValueStyle}"
                                               Text="{Binding TrackSpare, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  执行机构状态  -->
                    <Border Grid.Row="4" Style="{StaticResource EquipCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource EquipCardTitleStyle}" Text="设备执行机构状态" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource EquipCardHintStyle}"
                                           Text="8 路开关量" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,12,0,0"
                                  ColumnDefinitions="*,10,*,10,*,10,*"
                                  RowDefinitions="*,8,*">
                                <control:ActuatorStatusTile Grid.Row="0"
                                                            Grid.Column="0"
                                                            IsOn="{Binding IgbtPowerOn, FallbackValue=False}"
                                                            Label="IGBT 电源"
                                                            OffText="未通电"
                                                            OnText="已通电" />
                                <control:ActuatorStatusTile Grid.Row="0"
                                                            Grid.Column="2"
                                                            IsOn="{Binding YAxisInPosition, FallbackValue=False}"
                                                            Label="Y 轴跟踪"
                                                            OffText="未到位"
                                                            OnText="到位" />
                                <control:ActuatorStatusTile Grid.Row="0"
                                                            Grid.Column="4"
                                                            IsOn="{Binding ZAxisInPosition, FallbackValue=False}"
                                                            Label="Z 轴跟踪"
                                                            OffText="未到位"
                                                            OnText="到位" />
                                <control:ActuatorStatusTile Grid.Row="0"
                                                            Grid.Column="6"
                                                            IsOn="{Binding JackSafePosition, FallbackValue=False}"
                                                            Label="顶料缸安全位"
                                                            OffText="未安全"
                                                            OnText="安全" />

                                <control:ActuatorStatusTile Grid.Row="2"
                                                            Grid.Column="0"
                                                            IsOn="{Binding AllowProcessing, FallbackValue=False}"
                                                            Label="允许加工"
                                                            OffText="禁止"
                                                            OnText="允许" />
                                <control:ActuatorStatusTile Grid.Row="2"
                                                            Grid.Column="2"
                                                            IsOn="{Binding FeedComplete, FallbackValue=False}"
                                                            Label="送料完成"
                                                            OffText="未完成"
                                                            OnText="完成" />
                                <control:ActuatorStatusTile Grid.Row="2"
                                                            Grid.Column="4"
                                                            IsOn="{Binding AutoRunning, FallbackValue=False}"
                                                            Label="自动运行"
                                                            OffText="停止"
                                                            OnText="运行" />
                                <control:ActuatorStatusTile Grid.Row="2"
                                                            Grid.Column="6"
                                                            IsOn="{Binding SpareActuator, FallbackValue=False}"
                                                            Label="备用"
                                                            OffText="空闲"
                                                            OnText="就绪" />
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Margin="0,10,0,0"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource EquipCardHintStyle}"
                                       Text="8 路开关量每 200 ms 回读一次。" />
                        </Grid>
                    </Border>
                </Grid>

                <!--  右列：电参数（数字读数 + 量程条）  -->
                <Border Grid.Column="2" Style="{StaticResource EquipCardStyle}">
                    <Grid RowDefinitions="Auto,10,*,*,*,*">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Style="{StaticResource EquipCardTitleStyle}" Text="电参数" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource EquipCardHintStyle}"
                                       Text="4 路模拟量" />
                        </Grid>

                        <!--  电压  -->
                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource EquipSeparatorBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="0,8"
                                  VerticalAlignment="Center"
                                  RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EquipMetricLabelStyle}" Text="电压" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource EquipMutedTextBrush}"
                                                   Text="三相线电压" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricUnitStyle}"
                                               Text="V" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource EquipMetricValueStyle}"
                                           Text="{Binding Voltage, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <ProgressBar Grid.Row="2"
                                             Height="4"
                                             Margin="0,8,0,0"
                                             Maximum="600"
                                             Style="{StaticResource EquipLevelBarStyle}"
                                             Value="{Binding Voltage, Mode=OneWay, FallbackValue=0}" />
                                <Grid Grid.Row="3"
                                      Margin="0,4,0,0"
                                      ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource EquipMetricScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricScaleStyle}"
                                               Text="600" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  电流  -->
                        <Border Grid.Row="3"
                                BorderBrush="{StaticResource EquipSeparatorBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="0,8"
                                  VerticalAlignment="Center"
                                  RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EquipMetricLabelStyle}" Text="电流" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource EquipMutedTextBrush}"
                                                   Text="焊接变压器原边" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricUnitStyle}"
                                               Text="A" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource EquipMetricValueStyle}"
                                           Text="{Binding Current, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <ProgressBar Grid.Row="2"
                                             Height="4"
                                             Margin="0,8,0,0"
                                             Maximum="400"
                                             Style="{StaticResource EquipLevelBarStyle}"
                                             Value="{Binding Current, Mode=OneWay, FallbackValue=0}" />
                                <Grid Grid.Row="3"
                                      Margin="0,4,0,0"
                                      ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource EquipMetricScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricScaleStyle}"
                                               Text="400" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  功率  -->
                        <Border Grid.Row="4"
                                BorderBrush="{StaticResource EquipSeparatorBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="0,8"
                                  VerticalAlignment="Center"
                                  RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EquipMetricLabelStyle}" Text="功率" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource EquipMutedTextBrush}"
                                                   Text="瞬时加热功率" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricUnitStyle}"
                                               Text="kW" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource EquipMetricValueStyle}"
                                           Text="{Binding Power, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <ProgressBar Grid.Row="2"
                                             Height="4"
                                             Margin="0,8,0,0"
                                             Maximum="200"
                                             Style="{StaticResource EquipLevelBarStyle}"
                                             Value="{Binding Power, Mode=OneWay, FallbackValue=0}" />
                                <Grid Grid.Row="3"
                                      Margin="0,4,0,0"
                                      ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource EquipMetricScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricScaleStyle}"
                                               Text="200" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  能量  -->
                        <Border Grid.Row="5">
                            <Grid Margin="0,8"
                                  VerticalAlignment="Center"
                                  RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EquipMetricLabelStyle}" Text="能量" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource EquipMutedTextBrush}"
                                                   Text="单次焊接累计" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricUnitStyle}"
                                               Text="kW·s" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource EquipMetricValueStyle}"
                                           Text="{Binding Energy, StringFormat={}{0:0.000}, FallbackValue='0.000'}" />
                                <ProgressBar Grid.Row="2"
                                             Height="4"
                                             Margin="0,8,0,0"
                                             Maximum="20000"
                                             Style="{StaticResource EquipLevelBarStyle}"
                                             Value="{Binding Energy, Mode=OneWay, FallbackValue=0}" />
                                <Grid Grid.Row="3"
                                      Margin="0,4,0,0"
                                      ColumnDefinitions="*,Auto">
                                    <TextBlock Style="{StaticResource EquipMetricScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource EquipMetricScaleStyle}"
                                               Text="20000" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  页脚状态条  -->
        <Border Grid.Row="1"
                Height="46"
                BorderBrush="{StaticResource EquipSeparatorBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="64,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EquipFooterTextStyle}" Text="版本" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource EquipFooterEmphasisStyle}"
                               Text="{Binding AppVersion, FallbackValue=—}" />
                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource EquipFooterTextStyle}"
                               Text="当前界面" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource EquipFooterEmphasisStyle}"
                               Text="实时数据" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EquipFooterTextStyle}" Text="通讯状态" />
                    <Ellipse Width="7"
                             Height="7"
                             Margin="7,0,0,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource EquipOfflineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommunicationOk, FallbackValue=False}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource EquipOnlineBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource EquipFooterEmphasisStyle}" TargetType="TextBlock">
                                <Setter Property="Text" Value="中断" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommunicationOk, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="正常" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource EquipFooterTextStyle}"
                               Text="通讯延迟" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource EquipFooterEmphasisStyle}"
                               Text="{Binding CommunicationDelayMs, StringFormat={}{0} ms, FallbackValue='0 ms'}" />

                    <TextBlock Margin="18,0,0,0"
                               Style="{StaticResource EquipFooterTextStyle}"
                               Text="{Binding ClockText, FallbackValue=—}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

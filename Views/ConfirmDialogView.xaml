<UserControl x:Class="RailWeldApp.Views.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="220">
    <Border Width="420"
            Padding="24"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource WebBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}">
        <StackPanel>
            <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                       FontSize="18"
                       Foreground="{StaticResource WebForegroundBrush}"
                       Text="{Binding Title}"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,10,0,0"
                       FontSize="14"
                       Foreground="{StaticResource WebMutedForegroundBrush}"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding CancelCommand}"
                        Content="{Binding CancelText}"
                        Style="{StaticResource SecondaryButton}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmText}"
                        Style="{StaticResource AccentButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

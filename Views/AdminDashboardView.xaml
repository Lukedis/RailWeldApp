                        <TextBlock Style="{StaticResource AdminHeroHeadlineStyle}">
                            <Run Text="让每一道焊缝" />
                            <LineBreak />
                            <Run Foreground="{StaticResource AccentBrush}" Text="都有据可查" />
                        </TextBlock>


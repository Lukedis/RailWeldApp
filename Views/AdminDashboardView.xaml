                                     Height="6"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}" />
                            <TextBlock Style="{StaticResource AdminHeroEyebrowStyle}" Text="RAILWELD · 焊接过程数字化平台" />

                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource DashCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource DashCardIconStyle}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="24"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="&#xE9D2;" />
                            </Border>
                            <TextBlock Style="{StaticResource DashCardTitleStyle}" Text="质量追溯" />
                            <TextBlock Style="{StaticResource DashCardBodyStyle}" Text="曲线、判定结果与操作人一并归档，随时按焊缝编号回查，报告一键导出。" />
                            <TextBlock Style="{StaticResource DashCardLinkStyle}" Text="查看历史查询 →" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!--  功能展示一：实时数据  -->
            <Border MaxWidth="1240"
                    Margin="0,120,0,0"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    Style="{StaticResource DashShowcaseStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                MaxWidth="520"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DashSectionKickerStyle}" Text="实时数据" />
                        <TextBlock Style="{StaticResource DashShowcaseTitleStyle}" Text="每一路信号，都看得见" />
                        <TextBlock Style="{StaticResource DashShowcaseBodyStyle}" Text="三轴伺服、12 路模拟量、8 路开关量同时上图。异常自动标红，历史曲线随焊缝一起归档。" />

                        <StackPanel Margin="0,24,0,0">
                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource DashBulletDotStyle}" />
                                <TextBlock Style="{StaticResource DashBulletTextStyle}" Text="电压 / 电流 / 功率 / 能量四路电参数" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource DashBulletDotStyle}" />
                                <TextBlock Style="{StaticResource DashBulletTextStyle}" Text="温度、流量、位移共 12 路模拟量" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource DashBulletDotStyle}" />
                                <TextBlock Style="{StaticResource DashBulletTextStyle}" Text="执行机构 8 路状态实时点亮" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="360"
                            Margin="48,0,0,0"
                            Padding="28,24"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel>
                            <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="轨顶温度" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="{StaticResource FontSizeReadout}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="812.4 ℃" />
                            <Border Height="8"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    CornerRadius="4">
                                <Border Width="270"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="4" />
                            </Border>

                            <TextBlock Margin="0,22,0,0"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="喷风压力" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="{StaticResource FontSizeDisplay}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="0.44 MPa" />

                            <TextBlock Margin="0,22,0,0"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="采样延迟" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="{StaticResource FontSizeDisplay}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="16 ms" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  功能展示二：三阶段工艺  -->
            <Border MaxWidth="1240"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    Style="{StaticResource DashShowcaseStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DashSectionKickerStyle}" Text="工艺执行" />
                    <TextBlock Style="{StaticResource DashShowcaseTitleStyle}" Text="起始、转变、最终，三段都按设定走" />
                    <TextBlock Style="{StaticResource DashShowcaseBodyStyle}" Text="每段独立设定温度、功率与冷却方式，执行时逐段校验；任何一段超差，立即停机并记录。" />

                    <Grid Margin="0,32,0,0" ColumnDefinitions="*,16,*,16,*">
                        <Border Grid.Column="0" Style="{StaticResource DashStageCardStyle}">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="起始状态" />
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Border Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="650 ℃" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="55 %" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="时间控制" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource DashStageCardStyle}">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="转变状态" />
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Border Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="780 ℃" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="72 %" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="温度控制" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource DashStageCardStyle}">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="最终状态" />
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Border Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="720 ℃" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="45 %" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Style="{StaticResource DashChipStyle}">
                                        <TextBlock Style="{StaticResource DashChipTextStyle}" Text="温度控制" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  五种能力：窄卡横排  -->
            <Grid MaxWidth="1240"
                  Margin="0,24,0,0"
                  HorizontalAlignment="Stretch"
                  ColumnDefinitions="*,16,*,16,*,16,*,16,*">
                <Border Grid.Column="0" Style="{StaticResource DashMiniCardStyle}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashMiniKickerStyle}" Text="参数采集" />
                            <TextBlock Style="{StaticResource DashMiniTitleStyle}" Text="200ms 周期&#x0A;四路电参数" />
                            <TextBlock Style="{StaticResource DashMiniBodyStyle}" Text="电压、电流、功率、能量同屏。" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource DashMiniIconTileStyle}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE9D9;" />
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource DashMiniArrowStyle}">
                            <TextBlock Style="{StaticResource DashArrowTextStyle}" Text="›" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DashMiniCardStyle}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashMiniKickerStyle}" Text="工艺执行" />
                            <TextBlock Style="{StaticResource DashMiniTitleStyle}" Text="三段温度&#x0A;逐段校验" />
                            <TextBlock Style="{StaticResource DashMiniBodyStyle}" Text="起始、转变、最终各段独立设定。" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource DashMiniIconTileStyle}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE945;" />
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource DashMiniArrowStyle}">
                            <TextBlock Style="{StaticResource DashArrowTextStyle}" Text="›" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource DashMiniCardStyle}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashMiniKickerStyle}" Text="质量追溯" />
                            <TextBlock Style="{StaticResource DashMiniTitleStyle}" Text="一缝一档&#x0A;随时回查" />
                            <TextBlock Style="{StaticResource DashMiniBodyStyle}" Text="曲线、判定与操作人一起归档。" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource DashMiniIconTileStyle}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE9D2;" />
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource DashMiniArrowStyle}">
                            <TextBlock Style="{StaticResource DashArrowTextStyle}" Text="›" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource DashMiniCardStyle}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashMiniKickerStyle}" Text="故障报警" />
                            <TextBlock Style="{StaticResource DashMiniTitleStyle}" Text="分级提示&#x0A;不丢一条" />
                            <TextBlock Style="{StaticResource DashMiniBodyStyle}" Text="通信中断、超差、停机都有记录。" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource DashMiniIconTileStyle}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE7BA;" />
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource DashMiniArrowStyle}">
                            <TextBlock Style="{StaticResource DashArrowTextStyle}" Text="›" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource DashMiniCardStyle}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashMiniKickerStyle}" Text="报告导出" />
                            <TextBlock Style="{StaticResource DashMiniTitleStyle}" Text="一次成表&#x0A;直接打印" />
                            <TextBlock Style="{StaticResource DashMiniBodyStyle}" Text="按班次或焊缝编号批量导出。" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource DashMiniIconTileStyle}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE9F9;" />
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource DashMiniArrowStyle}">
                            <TextBlock Style="{StaticResource DashArrowTextStyle}" Text="›" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  两张带图的大卡  -->
            <Grid MaxWidth="1240"
                  Margin="0,24,0,0"
                  HorizontalAlignment="Stretch"
                  ColumnDefinitions="*,24,*">

                <Border Grid.Column="0" Style="{StaticResource DashPromoCardStyle}">
                    <Grid RowDefinitions="300,Auto">
                        <Grid Grid.Row="0" Height="300">
                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="24,24,0,0" />
                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{StaticResource AdminHomeRailSceneImage}"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="24"
                                                       RadiusY="24"
                                                       Rect="0,0,600,300" />
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="32,26,32,32">
                            <Border Style="{StaticResource DashNewChipStyle}">
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="现场" />
                            </Border>
                            <TextBlock Style="{StaticResource DashPromoTitleStyle}" Text="无缝线路 · 现场采集" />
                            <TextBlock Style="{StaticResource DashPromoBodyStyle}" Text="从轨顶温度到喷风压力，把现场每一路信号带回来，落成可追溯的焊缝档案。" />

                            <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                                <Button Height="38"
                                        Padding="20,0"
                                        Command="{Binding OpenRealTimeDataCommand}"
                                        Content="查看实时数据"
                                        Style="{StaticResource AccentButton}" />
                                <Button Height="38"
                                        Margin="10,0,0,0"
                                        Padding="20,0"
                                        Command="{Binding OpenTempMonitorCommand}"
                                        Content="温度监视"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DashPromoCardStyle}">
                    <Grid RowDefinitions="300,Auto">
                        <Grid Grid.Row="0" Height="300">
                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="24,24,0,0" />
                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{StaticResource AdminHomeSparksImage}"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="24"
                                                       RadiusY="24"
                                                       Rect="0,0,600,300" />
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="32,26,32,32">
                            <Border Style="{StaticResource DashNewChipStyle}">
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="工艺" />
                            </Border>
                            <TextBlock Style="{StaticResource DashPromoTitleStyle}" Text="闪光对焊 · 工艺执行" />
                            <TextBlock Style="{StaticResource DashPromoBodyStyle}" Text="三段温度、功率与冷却方式逐段下发，超差立即停机，原因写进记录。" />

                            <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                                <Button Height="38"
                                        Padding="20,0"
                                        Command="{Binding OpenRealTimeDataCommand}"
                                        Content="查看自动控制"
                                        Style="{StaticResource AccentButton}" />
                                <Button Height="38"
                                        Margin="10,0,0,0"
                                        Padding="20,0"
                                        Command="{Binding OpenTempMonitorCommand}"
                                        Content="了解更多"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  收尾  -->
            <Border MaxWidth="1240"
                    Margin="0,120,0,0"
                    Padding="56,52"
                    HorizontalAlignment="Stretch"
                    CornerRadius="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{StaticResource InkPrimary}" />
                        <GradientStop Offset="1" Color="{StaticResource InkStrong}" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                   FontSize="{StaticResource FontSizeHero}"
                                   Foreground="{StaticResource SurfaceCardBrush}"
                                   Text="从今天起，每一道焊缝都有据可查" />
                        <TextBlock Margin="0,14,0,0"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   Foreground="{StaticResource AccentTint200Brush}"
                                   Text="接入你的产线，历史数据自动归档，报告随时导出。" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Height="44"
                            Padding="24,0"
                            VerticalAlignment="Center"
                            Command="{Binding OpenRealTimeDataCommand}"
                            Content="查看实时数据"
                            Style="{StaticResource AdminHeroPrimaryButtonStyle}" />
                </Grid>
            </Border>

            <!--  页脚  -->
            <Border Margin="0,64,0,0"
                    Padding="0,22"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid MaxWidth="1240"
                      HorizontalAlignment="Stretch"
                      ColumnDefinitions="*,Auto">
                    <TextBlock FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="© 2026 RailWeld · 工业控制" />
                    <TextBlock Grid.Column="1"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="焊接过程数字化平台" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

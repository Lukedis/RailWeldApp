                                    Padding="24,0"
                                    Command="{Binding OpenRealTimeDataCommand}"
                                    Content="查看实时数据"
                                    Style="{StaticResource AdminHeroPrimaryButtonStyle}" />
                            <Button Height="44"
                                    Margin="12,0,0,0"
                                    Padding="24,0"
                                    Command="{Binding OpenTempMonitorCommand}"
                                    Content="查看温度监视"
                                    Style="{StaticResource AdminHeroGhostButtonStyle}" />

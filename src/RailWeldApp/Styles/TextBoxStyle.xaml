<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties">

    <!--  shadcn/ui Input：36px、圆角 6、1px 边框、深色聚焦边框  -->
    <Style x:Key="TextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WebForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WebInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SelectionBrush" Value="{StaticResource WebMutedHoverBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource WebForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="helper:CornerRadiusHelper.CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FieldIcon"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Foreground="{StaticResource WebMutedForegroundBrush}"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:TextBoxHelper.IconText)}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Margin" Value="12,0,6,0" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Grid.Column="1">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="16,0,16,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />

                                    <TextBlock x:Name="FieldPlaceholder"
                                               Margin="16,0,16,0"
                                               VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{StaticResource WebMutedForegroundBrush}"
                                               IsHitTestVisible="False"
                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:TextBoxHelper.Placeholder)}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource WebMutedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource WebForegroundBrush}" />
                            <Setter TargetName="FieldIcon" Property="Foreground" Value="{StaticResource WebForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource WebMutedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource WebMutedForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargeTextBoxStyle"
           BasedOn="{StaticResource TextBoxStyle}"
           TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="LargePlainPasswordTextBoxStyle"
           BasedOn="{StaticResource LargeTextBoxStyle}"
           TargetType="{x:Type TextBox}" />
</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        页面：设备管理（AdminRealTimeDataView）
        纯展示看板：表格用固定行高的 Grid（数据量固定，不需要虚拟化），
        仪表是矢量 Shape，只有指针角度会变。
    -->

    <Style x:Key="EquipCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Background" Value="{StaticResource EquipCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EquipCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style x:Key="EquipCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="EquipCardHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource EquipMutedTextBrush}" />
    </Style>

    <!-- 表头：小一号、弱化 -->
    <Style x:Key="EquipTableHeaderStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="EquipTableHeaderRightStyle"
           BasedOn="{StaticResource EquipTableHeaderStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="EquipTableIndexStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="EquipTableCellStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="EquipTableValueStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 传感器分组的标题行 -->
    <Style x:Key="EquipGroupHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EquipTableHeaderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- 执行机构：灯 + 名称 -->
    <Style x:Key="EquipActuatorLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 电参数数字读数 -->
    <Style x:Key="EquipMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="EquipMetricUnitStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource EquipMutedTextBrush}" />
    </Style>

    <Style x:Key="EquipMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeReadout}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="EquipMetricScaleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource EquipMutedTextBrush}" />
    </Style>

    <!--
        量程条：4px 细条，只画底轨 + 指示段。
        ProgressBar 自己按 Value / Maximum 算比例，不需要转换器。
    -->
    <Style x:Key="EquipLevelBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource EquipBarFillBrush}" />
        <Setter Property="Background" Value="{StaticResource EquipBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

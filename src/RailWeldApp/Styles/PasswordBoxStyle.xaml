<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties">

    <!--  shadcn/ui Password Input：与 TextBox 完全一致的边框、圆角和高度  -->
    <Style x:Key="PasswordBoxStyle" TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WebForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WebInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontMedium}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="helper:CornerRadiusHelper.CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Grid>
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FieldIcon"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Foreground="{StaticResource WebMutedForegroundBrush}"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:PassWordBoxHelper.IconText)}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Margin" Value="12,0,6,0" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Grid.Column="1">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="16,0,16,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />

                                    <TextBlock x:Name="FieldPlaceholder"
                                               Margin="16,0,16,0"
                                               VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{StaticResource WebMutedForegroundBrush}"
                                               IsHitTestVisible="False"
                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:PassWordBoxHelper.Placeholder)}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helper:PassWordBoxHelper.IsEmpty)}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource WebMutedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource WebForegroundBrush}" />
                            <Setter TargetName="FieldIcon" Property="Foreground" Value="{StaticResource WebForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource WebMutedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource WebMutedForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargePasswordBoxStyle"
           BasedOn="{StaticResource PasswordBoxStyle}"
           TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PasswordVisibilityToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBackground"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusFull}">
                        <Grid Width="18" Height="18">
                            <Path x:Name="EyeOpen"
                                  Data="M1,9 C4.6,3.6 13.4,3.6 17,9 C13.4,14.4 4.6,14.4 1,9 Z M9,6.4 A2.6,2.6 0 1 1 9,11.6 A2.6,2.6 0 1 1 9,6.4 Z"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource WebMutedForegroundBrush}"
                                  StrokeThickness="1.2" />
                            <Path x:Name="EyeClosed"
                                  Data="M1,9 C4.6,3.6 13.4,3.6 17,9 C13.4,14.4 4.6,14.4 1,9 Z M2,1 L16,17"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource WebMutedForegroundBrush}"
                                  StrokeThickness="1.2"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="EyeOpen" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EyeClosed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBackground" Property="Background" Value="{StaticResource WebMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
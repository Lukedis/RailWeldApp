<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RailWeldApp.Controls">

    <Style TargetType="{x:Type local:DrawerControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DrawerControl}">
                    <Grid ClipToBounds="True">

                        <!-- 遮罩 -->
                        <Rectangle x:Name="PART_Overlay"
                                   Fill="{StaticResource OverlayBrush}"
                                   IsHitTestVisible="False"
                                   Opacity="0" />

                        <!-- Drawer 容器：尺寸 / 对齐 / 位移全部由代码后置控制 -->
                        <Border x:Name="PART_DrawerContainer"
                                Background="{TemplateBinding DrawerBackground}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1,0,0,0"
                                CornerRadius="16,0,0,16"
                                RenderTransformOrigin="0,0">

                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PART_Transform" />
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Content="{TemplateBinding DrawerContent}" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- 右侧（默认）：左侧圆角 + 左侧描边 + 阴影向左 -->
                        <Trigger Property="Position" Value="Right">
                            <Setter TargetName="PART_DrawerContainer" Property="CornerRadius" Value="16,0,0,16" />
                            <Setter TargetName="PART_DrawerContainer" Property="BorderThickness" Value="1,0,0,0" />
                        </Trigger>

                        <!-- 左侧：右侧圆角 + 右侧描边 + 阴影向右 -->
                        <Trigger Property="Position" Value="Left">
                            <Setter TargetName="PART_DrawerContainer" Property="CornerRadius" Value="0,16,16,0" />
                            <Setter TargetName="PART_DrawerContainer" Property="BorderThickness" Value="0,0,1,0" />
                        </Trigger>

                        <!-- 顶部：底部圆角 + 底部描边 + 阴影向下 -->
                        <Trigger Property="Position" Value="Top">
                            <Setter TargetName="PART_DrawerContainer" Property="CornerRadius" Value="0,0,16,16" />
                            <Setter TargetName="PART_DrawerContainer" Property="BorderThickness" Value="0,0,0,1" />
                        </Trigger>

                        <!-- 底部：顶部圆角 + 顶部描边 + 阴影向上 -->
                        <Trigger Property="Position" Value="Bottom">
                            <Setter TargetName="PART_DrawerContainer" Property="CornerRadius" Value="16,16,0,0" />
                            <Setter TargetName="PART_DrawerContainer" Property="BorderThickness" Value="0,1,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

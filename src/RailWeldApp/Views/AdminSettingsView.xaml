<UserControl x:Class="RailWeldApp.Views.AdminSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RailWeldApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminSettingsViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             mc:Ignorable="d">

    <Grid Background="{StaticResource SettingsPageBackgroundBrush}" ClipToBounds="True">
        <Grid Margin="64,28,64,16" RowDefinitions="Auto,16,*,16,Auto">

            <!--  通信连接  -->
            <Grid RowDefinitions="Auto,16,Auto">

                <Grid Grid.Row="2" ColumnDefinitions="*,24,*">

                    <!--  Modbus RTU  -->
                    <Border Grid.Column="0"
                            Padding="0"
                            CornerRadius="{StaticResource RadiusXl}">
                        <Border Grid.Column="0"
                                Padding="18"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusXl}">
                            <Grid RowDefinitions="Auto,16,Auto,16,Auto,16,Auto">

                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="38"
                                            Height="38"
                                            Background="{StaticResource AccentTint100Brush}"
                                            CornerRadius="{StaticResource RadiusMd}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="17"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="&#xE968;" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                                       FontSize="16"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="Modbus RTU" />
                                            <controls:HelpTip Margin="6,0,0,0" Text="串口、从站地址和校验方式来自 appsettings.json，修改后需要重启程序。" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="串口通信 · Modbus 主站" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Padding="10,6"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SettingsPanelBackgroundBrush}"
                                            CornerRadius="{StaticResource RadiusLg}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="&#xE946;" />
                                            <TextBlock Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding ModbusConnectionStatus, FallbackValue=未连接, TargetNullValue=未连接}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2"
                                        Padding="12"
                                        Background="{StaticResource SurfaceSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMd}">
                                    <Grid RowDefinitions="Auto,10,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="连接方式" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextStrongBrush}"
                                                       Text="串口 / RTU" />
                                        </Grid>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="参数来源" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextStrongBrush}"
                                                       Text="appsettings.json" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextBodyBrush}"
                                                   Text="&#xEA39;" />
                                        <TextBlock Margin="5,0,0,0"
                                                   FontFamily="{StaticResource UiFontSemibold}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextBodyBrush}"
                                                   Text="最近错误" />
                                    </StackPanel>
                                    <TextBlock MaxHeight="36"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding ModbusLastError, TargetNullValue=暂无连接异常, FallbackValue=暂无连接异常}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="6"
                                        Padding="0,12,0,0"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Command="{Binding DisconnectModbusCommand}"
                                                Content="断开连接"
                                                IsEnabled="{Binding IsModbusConnected}"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Margin="8,0,0,0"
                                                Command="{Binding ConnectModbusCommand}"
                                                Content="连接设备"
                                                IsEnabled="{Binding IsModbusDisconnected}"
                                                Style="{StaticResource AccentButton}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <!--  Siemens PLC  -->
                    <Border Grid.Column="2"
                            Padding="0"
                            CornerRadius="{StaticResource RadiusXl}">
                        <Border Padding="18"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusXl}">
                            <Grid RowDefinitions="Auto,16,Auto,16,Auto,16,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Border Width="38"
                                                Height="38"
                                                Background="{StaticResource SuccessSoftBrush}"
                                                CornerRadius="{StaticResource RadiusMd}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="17"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="&#xE9D9;" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                                           FontSize="16"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="西门子 PLC" />
                                                <controls:HelpTip Margin="6,0,0,0" Text="IP、机架和槽位来自 appsettings.json；S7 通信使用 102 端口。" />
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="S7 以太网 · S7-1200" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Padding="10,6"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SettingsPanelBackgroundBrush}"
                                            CornerRadius="{StaticResource RadiusXl}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessDotBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="&#xE946;" />
                                            <TextBlock Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.Text>
                                                    <Binding Path="PlcConnectionStatus"
                                                             FallbackValue="未连接"
                                                             TargetNullValue="未连接" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2"
                                        Padding="12"
                                        Background="{StaticResource SurfaceSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMd}">
                                    <Grid RowDefinitions="Auto,10,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="连接方式" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextStrongBrush}"
                                                       Text="S7 以太网" />
                                        </Grid>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="参数来源" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextStrongBrush}"
                                                       Text="appsettings.json" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextBodyBrush}"
                                                   Text="&#xEA39;" />
                                        <TextBlock Margin="5,0,0,0"
                                                   FontFamily="{StaticResource UiFontSemibold}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextBodyBrush}"
                                                   Text="最近错误" />
                                    </StackPanel>
                                    <TextBlock MaxHeight="36"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding PlcLastError, TargetNullValue=暂无连接异常, FallbackValue=暂无连接异常}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="6"
                                        Padding="0,12,0,0"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Command="{Binding TogglePollingCommand}"
                                                Content="{Binding PollingButtonText}"
                                                IsEnabled="{Binding CanTogglePolling}"
                                                Style="{StaticResource AccentButton}" />
                                        <Button Margin="8,0,0,0"
                                                Command="{Binding DisconnectPlcCommand}"
                                                Content="断开连接"
                                                IsEnabled="{Binding IsPlcConnected}"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Margin="8,0,0,0"
                                                Command="{Binding ConnectPlcCommand}"
                                                Content="连接设备"
                                                IsEnabled="{Binding IsPlcDisconnected}"
                                                Style="{StaticResource AccentButton}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Grid>

            <!--  连接错误记录：占用剩余高度  -->
            <Border Grid.Row="2"
                    MinHeight="0"
                    Padding="18"
                    Background="{StaticResource SurfaceCardBrush}"
                    CornerRadius="{StaticResource RadiusXl}">
                <Grid RowDefinitions="Auto,12,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="连接错误记录" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="连接失败、通信超时与意外断开记录" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Background="{StaticResource SettingsPanelBackgroundBrush}"
                                CornerRadius="{StaticResource RadiusXs}">
                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding ConnectionErrors.Count, StringFormat=共 {0} 条记录}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            MinHeight="0"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource RadiusMd}">
                        <Grid>
                            <!--  显式开虚拟化 + 容器回收；原来竖滚动条是 Hidden，记录一多就只能看到头几条  -->
                            <Grid>
                                <ListView Background="Transparent"
                                          BorderThickness="0"
                                          ItemContainerStyle="{StaticResource SettingsLogRowContainerStyle}"
                                          ItemsSource="{Binding ConnectionErrors}"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource SettingsLogHeaderContainerStyle}">
                                            <GridViewColumn Width="170">
                                                <GridViewColumn.Header>
                                                    <TextBlock Style="{StaticResource SettingsLogHeaderTextStyle}" Text="发生时间" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Style="{StaticResource SettingsLogCellStyle}"
                                                                   Text="{Binding Time}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="130">
                                                <GridViewColumn.Header>
                                                    <TextBlock Style="{StaticResource SettingsLogHeaderTextStyle}" Text="通信类型" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource SettingsLogCellStyle}" Text="{Binding CommunicationType}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="570">
                                                <GridViewColumn.Header>
                                                    <TextBlock Style="{StaticResource SettingsLogHeaderTextStyle}" Text="错误详情" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource SettingsLogCellStyle}" Text="{Binding Message}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!--  空状态  -->
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionErrors.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="26"
                                               Foreground="{StaticResource TextDisabledBrush}"
                                               Text="&#xE7BA;" />
                                    <TextBlock Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="暂无连接错误记录" />
                                    <TextBlock Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Text="发生连接异常后，记录将显示在这里" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  底部说明卡：把连接相关的现场信息补齐  -->
            <Grid Grid.Row="4" ColumnDefinitions="*,16,*,16,*">
                <Border Padding="18"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXl}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38"
                                    Height="38"
                                    Background="{StaticResource AccentTint100Brush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="&#xE968;" />
                            </Border>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="连接自检" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="上线前确认三处参数与现场一致。" />
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="PLC：IP / 机架 / 槽位" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="串口：COM 口 / 波特率 / 校验" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="网络：S7 102 端口可达" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="18"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXl}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38"
                                    Height="38"
                                    Background="{StaticResource AccentTint100Brush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="&#xE7BA;" />
                            </Border>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="参数来源" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="连接参数来自配置文件，运行时只读。" />
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="appsettings.json" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="Plc / ModbusRTU 两节" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="修改后重启生效" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="18"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXl}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38"
                                    Height="38"
                                    Background="{StaticResource AccentTint100Brush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="&#xE9D9;" />
                            </Border>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="日志与审计" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="连接异常会同时写入日志与错误列表。" />
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="Logs/railweld-日期.log" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="默认保留 30 天" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Margin="9,0,0,0"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextBodyBrush}"
                                           Text="含时间、类型与错误详情" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

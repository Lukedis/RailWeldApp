<UserControl x:Class="RailWeldApp.Views.AdminTempMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RailWeldApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminTempMonitorViewModel}"
             d:DesignHeight="784"
             d:DesignWidth="1400"
             mc:Ignorable="d">

    <!--
        温度监视（纯前端）
        八路采集量，4×2 卡片：色点 + 通道名 + 量程 + 大数字 + 电平条 + 阈值说明，
        每路一个颜色（红 橙 黄 绿 青 蓝 靛 紫），和参考图的图例一一对应。
        卡片行高用 *，窗口越高卡片越高；整页再包一层 ScrollViewer，小屏时滚动而不是裁切。

        需要 VM（AdminTempMonitorViewModel）提供的成员：
        RailTopTemp  RailFootTemp  RailInnerFootTemp  CoolingTemp        （℃）
        AirPressure                                                        （MPa）
        FlowTop  FlowWeb  FlowBottom                                       （L/min）
        其余什么都不用做：量程与阈值写死在 XAML 里，每 200ms 刷新这 8 个数即可。

        性能：数值 TextBlock 给了固定宽度，数字长短变化不会引起卡片重新排版；
        每次刷新只重绘 8 段文字 + 8 条指示条。
        注意 ProgressBar.Value 默认是 TwoWay，VM 里是只读属性时一定要写 Mode=OneWay。
    -->

    <Grid Background="{StaticResource SurfaceCardBrush}" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="720"
                  Margin="64,22,64,16"
                  RowDefinitions="Auto,16,*,14,Auto">

                <!--  页头  -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AdminSectionKickerStyle}" Text="温度监视" />
                        <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                   FontSize="{StaticResource FontSizeDisplay}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="全自动钢轨焊接接头热处理设备" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="轨顶 / 轨脚 / 内轨脚 / 冷却四路温度，加喷风压力与三路冷却水流量，同一屏看全。" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="11,7"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource TempTrackBrush}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource TempOnlineBrush}" />
                            <TextBlock Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="实时采集 · 200 ms" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  八路采集量  -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,16,*,16,*,16,*"
                      RowDefinitions="*,16,*">

                    <!--  1 轨顶温度  -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel1Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="轨顶温度" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="焊缝表面加热温度" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–1000 ℃" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding RailTopTemp, StringFormat={}{0:0.0}, FallbackValue='0.0'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="℃" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel1Brush}"
                                             Maximum="1000"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding RailTopTemp, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="1000 ℃" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="报警上限 900 ℃ · 超限标红" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 01" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  2 轨脚温度  -->
                    <Border Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel2Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="轨脚温度" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="轨脚热影响区温度" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–1000 ℃" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding RailFootTemp, StringFormat={}{0:0.0}, FallbackValue='0.0'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="℃" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel2Brush}"
                                             Maximum="1000"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding RailFootTemp, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="1000 ℃" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="报警上限 900 ℃ · 超限标红" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 02" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  3 内轨脚温度  -->
                    <Border Grid.Row="0"
                            Grid.Column="4"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel3Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="内轨脚温度" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="内侧轨脚加热温度" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–1000 ℃" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding RailInnerFootTemp, StringFormat={}{0:0.0}, FallbackValue='0.0'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="℃" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel3Brush}"
                                             Maximum="1000"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding RailInnerFootTemp, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="1000 ℃" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="报警上限 900 ℃ · 超限标红" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 03" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  4 冷却温度  -->
                    <Border Grid.Row="0"
                            Grid.Column="6"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel4Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="冷却温度" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="冷却水回水温度" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–200 ℃" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding CoolingTemp, StringFormat={}{0:0.0}, FallbackValue='0.0'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="℃" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel4Brush}"
                                             Maximum="200"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding CoolingTemp, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="200 ℃" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="报警上限 60 ℃ · 回水检测" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 04" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  5 喷风压力  -->
                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel5Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="喷风压力" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="压缩空气供气压力" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–1.0 MPa" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding AirPressure, StringFormat={}{0:0.00}, FallbackValue='0.00'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="MPa" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel5Brush}"
                                             Maximum="1"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding AirPressure, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="1.0 MPa" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="正常 0.4–0.6 MPa · 低压禁止喷风" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 05" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  6 轨顶流量  -->
                    <Border Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel6Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="轨顶流量" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="轨顶冷却水流量" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–20 L/min" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding FlowTop, StringFormat={}{0:0.0}, FallbackValue='0.0'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="L/min" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel6Brush}"
                                             Maximum="20"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding FlowTop, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="20 L/min" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="正常 10–15 L/min · 断流报警" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 06" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  7 轨腰流量  -->
                    <Border Grid.Row="2"
                            Grid.Column="4"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel7Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="轨腰流量" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="轨腰冷却水流量" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–20 L/min" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding FlowWeb, StringFormat={}{0:0.0}, FallbackValue='0.0'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="L/min" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel7Brush}"
                                             Maximum="20"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding FlowWeb, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="20 L/min" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="正常 10–15 L/min · 断流报警" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 07" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  8 轨底流量  -->
                    <Border Grid.Row="2"
                            Grid.Column="6"
                            Style="{StaticResource TempCardStyle}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,7,0,0"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TempChannel8Brush}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{StaticResource TempNameStyle}" Text="轨底流量" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource TempCaptionStyle}"
                                               Text="轨底冷却水流量" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource TempRangeChipStyle}">
                                    <TextBlock Style="{StaticResource TempRangeStyle}" Text="0–20 L/min" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TempValueStyle}" Text="{Binding FlowBottom, StringFormat={}{0:0.0}, FallbackValue='0.0'}" />
                                    <TextBlock Style="{StaticResource TempUnitStyle}" Text="L/min" />
                                </StackPanel>
                                <ProgressBar Margin="0,18,0,0"
                                             Foreground="{StaticResource TempChannel8Brush}"
                                             Maximum="20"
                                             Style="{StaticResource TempBarStyle}"
                                             Value="{Binding FlowBottom, Mode=OneWay, FallbackValue=0}" />
                                <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Style="{StaticResource TempScaleStyle}" Text="0" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TempScaleStyle}"
                                               Text="20 L/min" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource TempSeparatorBrush}" />
                            <Grid Grid.Row="3"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource TempSpecStyle}" Text="正常 10–15 L/min · 断流报警" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TempChannelStyle}"
                                           Text="CH 08" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!--  底部横幅：把八路数据和归档链路串起来  -->
                <Border Grid.Row="4"
                        Padding="26,20"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        BorderBrush="{StaticResource TempSeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="46"
                                Height="46"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentTint50Brush}"
                                CornerRadius="12">
                            <Path Width="22"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M3,20 L9,13 L14,16 L21,6"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="八路采集，一条完整的热处理曲线" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="温度、压力与冷却水流量同步刷新；超限通道标红，曲线随账户与操作记录一起归档。" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Style="{StaticResource TempBannerChipStyle}">
                                <TextBlock Style="{StaticResource TempBannerChipTextStyle}" Text="温度 ×4" />
                            </Border>
                            <Border Margin="8,0,0,0" Style="{StaticResource TempBannerChipStyle}">
                                <TextBlock Style="{StaticResource TempBannerChipTextStyle}" Text="流量 ×3" />
                            </Border>
                            <Border Margin="8,0,0,0" Style="{StaticResource TempBannerChipStyle}">
                                <TextBlock Style="{StaticResource TempBannerChipTextStyle}" Text="压力 ×1" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>


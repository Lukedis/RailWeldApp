<UserControl x:Class="RailWeldApp.Views.AdminReportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties"
             xmlns:controls="clr-namespace:RailWeldApp.Controls"
             xmlns:views="clr-namespace:RailWeldApp.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminReportExportViewModel}"
             d:DesignHeight="784"
             d:DesignWidth="1400"
             mc:Ignorable="d">

    <!--
        报告导出（纯前端）：左侧选记录，右侧「焊接接头热处理质量报告」纸张预览。
        预览纸张 `ReportPaper` 就是打印源 —— 后端用 PrintDialog.PrintVisual(ReportPaper, …)
        （先按 A4 比例缩放）即可打印或“打印到 PDF”，不需要再写一套排版。

        需要 VM（AdminReportExportViewModel）提供的成员：
        SelectedDate  (DateTime?)   顶部日期，TwoWay
        SearchText    (string)      账户搜索，TwoWay
        ReportItems     (集合)        待生成报告（当天）
                                    Report : 记录摘要 + ProcessRows / MetricRows
        SelectedRecordId (string)   当前选中记录 Id，TwoWay
        SelectedRecord  (Report?)   由 SelectedRecordId 计算
        Report        (Report?)     右侧纸张绑这一个对象

        Report 字段：
            AccountName  OperatorName  JobNumber  ProducedAt
            EquipmentName  RecipeName  ShiftName  LineName
            IsQualified(bool)  ResultText(string)  ResultDetail(string)
            ReportNo(string)   GeneratedAt(string)
            ProcessRows (集合: Section / TempText / PowerText / CoolingMode / CoolingParam)
            MetricRows  (集合: Name / Start / Peak / End / Average / MinText / MaxText
                              OverCount(int) / HasOverLimit(bool) / Judgement)

        PrintCommand / ExportPdfCommand  (命令)
    -->

    <Grid Background="{StaticResource SurfaceCardBrush}" RowDefinitions="*,Auto">

        <Grid Grid.Row="0" Margin="64,20,64,14" RowDefinitions="Auto,10,*,14,Auto">

            <!--  页头  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource AdminSectionKickerStyle}" Text="报告导出" />
                    <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                               FontSize="{StaticResource FontSizeDisplay}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="全自动钢轨焊接接头热处理设备" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                Style="{StaticResource DatePickerStyle}" />
                    <TextBox Width="200"
                             Margin="10,0,0,0"
                             Style="{StaticResource TextBoxStyle}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             helper:TextBoxHelper.Placeholder="搜索账户" />
                </StackPanel>
            </Grid>

            <!--  主体  -->
            <Grid Grid.Row="2" ColumnDefinitions="320,16,*">

                <!-- 左：待生成报告 -->
                <Border Style="{StaticResource ReportCardStyle}">
                    <Grid RowDefinitions="Auto,8,Auto,4,*">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Style="{StaticResource ReportTitleStyle}" Text="待生成报告" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource ReportHintStyle}"
                                       Text="{Binding ReportItems.Count, StringFormat={}{0} 条, FallbackValue='0 条'}" />
                        </Grid>

                        <Border Grid.Row="2"
                                Height="26"
                                Background="{StaticResource ReportHeaderBrush}"
                                CornerRadius="{StaticResource RadiusXs}">
                            <Grid Margin="12,0" ColumnDefinitions="*,84,64">
                                <TextBlock Style="{StaticResource ReportHeaderStyle}" Text="账户" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ReportHeaderRightStyle}" Text="时间" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ReportHeaderRightStyle}" Text="判定" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <ListBox ItemsSource="{Binding ReportItems}"
                                     SelectedValue="{Binding SelectedRecordId, Mode=TwoWay}"
                                     SelectedValuePath="RecordId"
                                     Style="{StaticResource ReportListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,84,64">
                                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                                       Style="{StaticResource ReportCellStyle}"
                                                       Text="{Binding AccountName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource ReportCellRightStyle}"
                                                       Text="{Binding TimeText}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ReportResultStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReportItems.Count, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="24"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           Text="&#xE9D2;" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="今天还没有可导出的记录" />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="完成一次焊接后，报告会自动出现在这里" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右：报告预览 -->
                <Grid Grid.Column="2" RowDefinitions="Auto,10,*">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ReportTitleStyle}" Text="报告预览" />
                            <TextBlock Margin="10,0,0,0"
                                       Style="{StaticResource ReportHintStyle}"
                                       Text="{Binding Report.AccountName, StringFormat=A4 纵向 · 账户 {0}, FallbackValue='A4 纵向'}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="Print_Click"
                                    Content="打印"
                                    IsEnabled="{Binding HasReport}"
                                    Style="{StaticResource ReportPrimaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Click="ExportPdf_Click"
                                    Content="导出 PDF"
                                    IsEnabled="{Binding HasReport}"
                                    Style="{StaticResource ReportActionButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- 纸张：打印源；Viewbox 只放大预览，不改变 ReportPaper 的排版尺寸 -->
                    <Viewbox Grid.Row="2"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Stretch="Uniform"
                             StretchDirection="UpOnly">
                        <views:ReportPaperView x:Name="ReportPaper" />
                    </Viewbox>
                </Grid>
            </Grid>

            <!--  报告包含的内容：底部三卡  -->
            <Grid Grid.Row="4" ColumnDefinitions="*,16,*,16,*">
                <Border Padding="16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        CornerRadius="{StaticResource RadiusLg}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE9D9;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="工艺参数" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="三段温度 / 功率 / 冷却方式逐段记录" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        CornerRadius="{StaticResource RadiusLg}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE9D2;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="实测统计" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="起始 / 峰值 / 末值 / 均值与超限次数" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        CornerRadius="{StaticResource RadiusLg}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE945;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="判定结论" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="合格或超限，附复检建议与签字位" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <controls:PageFooter Grid.Row="1" />
    </Grid>
</UserControl>
<UserControl x:Class="RailWeldApp.Views.AccountManagementDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="700">
    <Border Width="860"
            MaxHeight="700"
            Padding="24"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource WebBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                   FontSize="18"
                                   Foreground="{StaticResource WebForegroundBrush}"
                                   Text="账户管理" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource WebMutedForegroundBrush}"
                                   Text="{Binding CurrentAccount, StringFormat=当前登录账户：{0}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding CloseDialogCommand}"
                            Content="关闭"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>

                <Grid Margin="0,18,0,0" ColumnDefinitions="300,20,*">
                    <!--  账户列表 + 新建  -->
                    <StackPanel Grid.Column="0">
                        <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                   FontSize="14"
                                   Foreground="{StaticResource WebForegroundBrush}"
                                   Text="账户列表" />

                        <ListBox Height="220"
                                 Margin="0,8,0,0"
                                 ItemsSource="{Binding Users}"
                                 SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                 BorderBrush="{StaticResource WebBorderBrush}"
                                 BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3" ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock FontSize="13"
                                                       Foreground="{StaticResource WebForegroundBrush}"
                                                       Text="{Binding Account}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource WebMutedForegroundBrush}"
                                                       Text="{Binding RoleText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource WebMutedForegroundBrush}"
                                                   Text="{Binding StatusText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Margin="0,16,0,0"
                                Padding="12"
                                Background="{StaticResource WebMutedBrush}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <StackPanel IsEnabled="{Binding CanManage}">
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="13"
                                           Foreground="{StaticResource WebForegroundBrush}"
                                           Text="新建操作员" />

                                <TextBox Margin="0,8,0,0"
                                         helper:TextBoxHelper.Placeholder="账号"
                                         Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding NewAccount, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox Margin="0,8,0,0"
                                         helper:TextBoxHelper.Placeholder="显示名称"
                                         Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <PasswordBox Margin="0,8,0,0"
                                             helper:PassWordBoxHelper.Password="{Binding NewPassword, Mode=TwoWay}"
                                             helper:PassWordBoxHelper.Placeholder="初始密码"
                                             Style="{StaticResource PasswordBoxStyle}" />

                                <ComboBox Margin="0,8,0,0"
                                          DisplayMemberPath="Text"
                                          ItemsSource="{Binding RoleOptions}"
                                          SelectedValue="{Binding NewRole}"
                                          SelectedValuePath="Value"
                                          Style="{StaticResource AutoComboBoxStyle}" />

                                <Button Margin="0,10,0,0"
                                        Command="{Binding CreateUserCommand}"
                                        Content="创建账户"
                                        Style="{StaticResource AccentButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  选中账户 -->
                    <StackPanel Grid.Column="2" IsEnabled="{Binding CanManage}">
                        <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                   FontSize="14"
                                   Foreground="{StaticResource WebForegroundBrush}"
                                   Text="账户详情" />

                        <Border Margin="0,8,0,0"
                                Padding="14"
                                Background="{StaticResource WebMutedBrush}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <StackPanel>
                                <TextBlock FontSize="13"
                                           Foreground="{StaticResource WebMutedForegroundBrush}"
                                           Text="账号" />
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="15"
                                           Foreground="{StaticResource WebForegroundBrush}"
                                           Text="{Binding SelectedUser.Account, FallbackValue=—}" />

                                <TextBlock Margin="0,12,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource WebMutedForegroundBrush}"
                                           Text="显示名称" />
                                <TextBox Margin="0,5,0,0"
                                         Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding SelectedUser.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,12,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource WebMutedForegroundBrush}"
                                           Text="角色权限" />
                                <ComboBox Margin="0,5,0,0"
                                          DisplayMemberPath="Text"
                                          ItemsSource="{Binding RoleOptions}"
                                          SelectedValue="{Binding SelectedUser.Role}"
                                          SelectedValuePath="Value"
                                          Style="{StaticResource AutoComboBoxStyle}" />

                                <CheckBox Margin="0,12,0,0"
                                          Content="启用账户"
                                          IsChecked="{Binding SelectedUser.IsEnabled}"
                                          Style="{StaticResource CheckBoxStyle}" />

                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                    <Button Command="{Binding SaveUserCommand}"
                                            Content="保存账户"
                                            Style="{StaticResource AccentButton}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding ToggleEnabledCommand}"
                                            Content="启用 / 禁用"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{StaticResource WebMutedBrush}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="13"
                                           Foreground="{StaticResource WebForegroundBrush}"
                                           Text="密码重置" />

                                <PasswordBox Margin="0,8,0,0"
                                             helper:PassWordBoxHelper.Password="{Binding ResetPassword, Mode=TwoWay}"
                                             helper:PassWordBoxHelper.Placeholder="新密码，至少 6 位"
                                             Style="{StaticResource PasswordBoxStyle}" />

                                <Button Margin="0,10,0,0"
                                        Command="{Binding ResetPasswordCommand}"
                                        Content="重置选中账户密码"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,12,0,0"
                                   FontSize="12"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

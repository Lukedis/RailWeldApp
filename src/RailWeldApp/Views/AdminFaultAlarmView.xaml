<UserControl x:Class="RailWeldApp.Views.AdminFaultAlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RailWeldApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminFaultAlarmViewModel}"
             d:DesignHeight="784"
             d:DesignWidth="1400"
             mc:Ignorable="d">

    <!--
        故障报警（纯前端）：顶部状态条 + 报警记录表 + 右侧统计与操作。
        没有定时器：只有报警字发生边沿变化时 VM 才改集合，平时 0% CPU。

        需要 VM（AdminFaultAlarmViewModel）提供的成员：
        AlarmRows       (集合)   报警记录，最新在上，建议保留最近 500 条
        HasActiveAlarm  (bool)   状态条配色与文案
        BannerText      (string) 状态条正文，例如
        "系统正常 · 暂无活动报警"
        "2 条未复位报警 · 最近 14:32 急停按下 · 已持续 3 分 12 秒"
        ActiveCount     (int)    未复位条数
        TodayCount      (int)    今日累计（同时用于空状态判断：为 0 时显示提示）
        LatestText      (string) 右侧「最近一次」的正文
        LevelOptions    (集合)   筛选下拉的选项，例如 全部 / 故障 / 警告 / 提示
        SelectedLevel   (string) 当前筛选，TwoWay
        AcknowledgeAllCommand / ResetCommand  (命令)

        AlarmRow : Time(string)  LevelText(string：故障/警告/提示)  Code(string，如 F1000)
        Message(string)  IsActive(bool)  DurationText(string)

        行为约定：
        · 报警出现 → 插入新行（IsActive=true）；恢复 → 只把该行 IsActive 改 false、补 DurationText，不删行；
        · 「确认全部」只写本地库，不动 PLC；「复位 PLC」写复位位，PLC 清掉后各行转「已恢复」。
        视图不做数值格式化、不用转换器，级别与状态的颜色都由 DataTrigger 映射。
    -->

    <Grid Background="{StaticResource SurfaceCardBrush}" RowDefinitions="*,Auto">

        <Grid Grid.Row="0"
              Margin="64,20,64,14"
              RowDefinitions="Auto,10,Auto,12,*">

            <!--  页头  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource AdminSectionKickerStyle}" Text="故障报警" />
                    <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                               FontSize="{StaticResource FontSizeDisplay}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="全自动钢轨焊接接头热处理设备" />
                </StackPanel>
            </Grid>

            <!--  状态条  -->
            <Border Grid.Row="2" Style="{StaticResource AlarmBannerStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse VerticalAlignment="Center" Style="{StaticResource AlarmBannerDotStyle}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,16,0"
                               Style="{StaticResource AlarmBannerTextStyle}"
                               Text="{Binding BannerText, FallbackValue='系统正常 · 暂无活动报警'}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Command="{Binding AcknowledgeAllCommand}"
                                Content="确认全部"
                                Style="{StaticResource AlarmActionButtonStyle}" />
                        <Button Height="34"
                                Margin="8,0,0,0"
                                Padding="16,0"
                                Command="{Binding ResetCommand}"
                                Content="复位 PLC"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  主体  -->
            <Grid Grid.Row="4" ColumnDefinitions="*,16,300">

                <!--  左：报警记录  -->
                <Border Style="{StaticResource AlarmCardStyle}">
                    <Grid RowDefinitions="Auto,8,Auto,4,*">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Style="{StaticResource AlarmTitleStyle}" Text="报警记录" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource AlarmHintStyle}"
                                       Text="今日 / 最近 500 条" />
                        </Grid>

                        <Border Grid.Row="2"
                                Height="26"
                                Background="{StaticResource AlarmHeaderBrush}"
                                CornerRadius="{StaticResource RadiusXs}">
                            <Grid Margin="12,0" ColumnDefinitions="92,84,76,*,84">
                                <TextBlock Style="{StaticResource AlarmHeaderStyle}" Text="时间" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource AlarmHeaderStyle}"
                                           Text="级别" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource AlarmHeaderStyle}"
                                           Text="代码" />
                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource AlarmHeaderStyle}"
                                           Text="内容" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource AlarmHeaderRightStyle}"
                                           Text="状态" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <ListBox ItemsSource="{Binding AlarmView}" Style="{StaticResource AlarmListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="92,84,76,*,84">
                                            <TextBlock Style="{StaticResource AlarmTimeStyle}" Text="{Binding Time, FallbackValue='—'}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource AlarmLevelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource AlarmCodeStyle}"
                                                       Text="{Binding Code, FallbackValue='—'}" />
                                            <TextBlock Grid.Column="3"
                                                       Style="{StaticResource AlarmCellStyle}"
                                                       Text="{Binding Message, FallbackValue='—'}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource AlarmStateStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource AlarmMutedBrush}"
                                       Text="今日还没有报警记录">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TodayCount, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!--  右：统计与筛选  -->
                <Border Grid.Column="2" Style="{StaticResource AlarmCardStyle}">
                    <Grid RowDefinitions="Auto,14,Auto,14,Auto,14,Auto,*,Auto">

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource AlarmTitleStyle}"
                                   Text="统计" />

                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource AlarmHintStyle}" Text="未复位报警" />
                            <TextBlock Text="{Binding ActiveCount, FallbackValue=0}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource AlarmStatValueStyle}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveAlarm, FallbackValue=False}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AlarmDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Style="{StaticResource AlarmHintStyle}" Text="今日累计" />
                            <TextBlock Style="{StaticResource AlarmStatValueStyle}" Text="{Binding TodayCount, FallbackValue=0}" />
                        </StackPanel>

                        <StackPanel Grid.Row="6">
                            <TextBlock Style="{StaticResource AlarmHintStyle}" Text="最近一次" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource AlarmBodyStyle}"
                                       Text="{Binding LatestText, FallbackValue='—'}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="8">
                            <Border Height="1" Background="{StaticResource AlarmSeparatorBrush}" />
                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource AlarmHintStyle}"
                                       Text="报警级别" />

                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource AlarmDangerBrush}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource AlarmBodyStyle}"
                                           Text="故障 · 立即停机处理" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource AlarmHintStyle}"
                                           Text="F1xxx" />
                            </Grid>
                            <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource AlarmWarnBrush}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource AlarmBodyStyle}"
                                           Text="警告 · 记录并观察" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource AlarmHintStyle}"
                                           Text="F1003" />
                            </Grid>
                            <Grid Margin="0,7,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource AlarmMutedBrush}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource AlarmBodyStyle}"
                                           Text="提示 · 工艺节点" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource AlarmHintStyle}"
                                           Text="F2xxx" />
                            </Grid>

                            <Border Height="1"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource AlarmSeparatorBrush}" />
                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource AlarmHintStyle}"
                                       Text="按级别筛选" />
                            <ComboBox Margin="0,6,0,0"
                                      ItemsSource="{Binding LevelOptions}"
                                      SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                                      Style="{StaticResource AlarmFilterStyle}" />
                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource AlarmHintStyle}"
                                       Text="确认 = 本地标记已知晓；复位 = 清 PLC 报警字，历史仍保留。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:PageFooter Grid.Row="1" />
    </Grid>
</UserControl>
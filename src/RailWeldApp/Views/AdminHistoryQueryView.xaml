<UserControl x:Class="RailWeldApp.Views.AdminHistoryQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RailWeldApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RailWeldApp.Design"
             xmlns:helper="clr-namespace:RailWeldApp.DependencyProperties"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{x:Static design:DesignData.AdminHistoryQueryViewModel}"
             d:DesignHeight="784"
             d:DesignWidth="1400"
             mc:Ignorable="d">

    <!--
        历史查询（纯前端）：左侧当天记录列表，右侧选中记录的指标统计 + 采样明细。
        没有曲线、没有定时器：页面只在「选日期 / 搜账户 / 选记录」时取一次数据。

        需要 VM（AdminHistoryQueryViewModel）提供的成员：
        SelectedDate   (DateTime?)        顶部日期，TwoWay
        SearchText     (string)          账户搜索框，TwoWay
        ResultCount    (int)             列表条数（右侧显示 "N 条"）
        HasResults     (bool)            是否有结果（false 时显示空状态）
        Records    (ObservableCollection<HistoryRecord>)
        SelectedRecordId (string)         当前选中记录 Id，TwoWay
        SelectedRecord   (HistoryRecord?) 由 SelectedRecordId 计算

        HistoryRecord : RecordId / AccountName / StartedAtText / MetaText / IsAbnormal
+                        Metrics / Samples（右侧只绑这一个对象）
        Metric : Name(string)  Start/Peak/End/Average(string)  OverCount(int)
                 PeakRatio(double 0~1，峰值条用)  HasOverLimit(bool)
        Sample : Time(string)  Temp1~Temp4(string)  Pressure(string)  Flow1~Flow3(string)

        性能：一次选择 = 一次列表查询（一天几十~几百行）+ 一次统计聚合 + 一次样本查询；
        两个 ListBox 都开了虚拟化，样本列表行高固定 28。页面静止时 0% CPU。
        数值都由 VM 格式化成字符串，视图不做 StringFormat / 转换器。
    -->

    <Grid Background="{StaticResource SurfaceCardBrush}" RowDefinitions="*,Auto">

        <Grid Grid.Row="0"
              Margin="64,20,64,14"
              RowDefinitions="Auto,10,*">

            <!--  页头  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource AdminSectionKickerStyle}" Text="历史查询" />
                    <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                               FontSize="{StaticResource FontSizeDisplay}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="全自动钢轨焊接接头热处理设备" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Style="{StaticResource DatePickerStyle}" />
                    <TextBox Width="210"
                             Margin="10,0,0,0"
                             helper:TextBoxHelper.Placeholder="搜索账户"
                             Style="{StaticResource TextBoxStyle}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!--  主体  -->
            <Grid Grid.Row="2" ColumnDefinitions="340,16,*">

                <!--  左：记录列表  -->
                <Border Style="{StaticResource HistoryCardStyle}">
                    <Grid RowDefinitions="Auto,8,Auto,4,*">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Style="{StaticResource HistoryTitleStyle}" Text="记录列表" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource HistoryHintStyle}"
                                       Text="{Binding ResultCount, StringFormat={}{0} 条, FallbackValue='0 条'}" />
                        </Grid>

                        <Border Grid.Row="2"
                                Height="26"
                                Background="{StaticResource HistoryHeaderBrush}"
                                CornerRadius="{StaticResource RadiusXs}">
                            <Grid Margin="12,0" ColumnDefinitions="*,88,60">
                                <TextBlock Style="{StaticResource HistoryHeaderStyle}" Text="账户" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource HistoryHeaderRightStyle}"
                                           Text="时间" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource HistoryHeaderRightStyle}"
                                           Text="状态" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <ListBox ItemsSource="{Binding Records}"
                                     SelectedValue="{Binding SelectedRecordId, Mode=TwoWay}"
                                     SelectedValuePath="RecordId"
                                     Style="{StaticResource HistoryListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,88,60">
                                            <TextBlock FontFamily="{StaticResource UiFontMedium}"
                                                       Style="{StaticResource HistoryCellStyle}"
                                                       Text="{Binding AccountName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding StartedAtText}" />
                                            <TextBlock Grid.Column="2"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource HistoryStatusStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Style="{StaticResource HistoryEmptyStyle}" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  右：统计 + 采样  -->
                <Border Grid.Column="2" Style="{StaticResource HistoryCardStyle}">
                    <Grid RowDefinitions="Auto,12,Auto,6,Auto,12,*">

                        <!--  摘要  -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding SelectedRecord.AccountName, FallbackValue='请选择左侧记录'}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource HistoryHintStyle}"
                                           Text="{Binding SelectedRecord.MetaText, FallbackValue='—'}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           Style="{StaticResource HistoryHintStyle}"
                                           Text="判定" />
                                <TextBlock Style="{StaticResource HistorySummaryStatusStyle}" />
                            </StackPanel>
                        </Grid>

                        <!--  指标统计  -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,6,Auto,4,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource HistoryTitleStyle}" Text="指标统计" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource HistoryHintStyle}"
                                           Text="一次焊接的起始 / 峰值 / 末值 / 均值" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Height="26"
                                    Background="{StaticResource HistoryHeaderBrush}"
                                    CornerRadius="{StaticResource RadiusXs}">
                                <Grid Margin="12,0" ColumnDefinitions="*,80,80,80,80,54,120">
                                    <TextBlock Style="{StaticResource HistoryHeaderStyle}" Text="指标" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="起始" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="峰值" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="末值" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="均值" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="超限" />
                                    <TextBlock Grid.Column="6"
                                               Margin="24,0,0,0"
                                               Style="{StaticResource HistoryHeaderStyle}"
                                               Text="峰值占比" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="4"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{Binding SelectedRecord.Metrics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30" ColumnDefinitions="*,80,80,80,80,54,120">
                                                <TextBlock Style="{StaticResource HistoryMetricNameStyle}" Text="{Binding Name, FallbackValue='—'}" />
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource HistoryCellRightStyle}"
                                                           Text="{Binding Start, FallbackValue='—'}" />
                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource HistoryCellRightStyle}"
                                                           Text="{Binding Peak, FallbackValue='—'}" />
                                                <TextBlock Grid.Column="3"
                                                           Style="{StaticResource HistoryCellRightStyle}"
                                                           Text="{Binding End, FallbackValue='—'}" />
                                                <TextBlock Grid.Column="4"
                                                           Style="{StaticResource HistoryCellRightStyle}"
                                                           Text="{Binding Average, FallbackValue='—'}" />
                                                <TextBlock Grid.Column="5"
                                                           Style="{StaticResource HistoryOverCountStyle}"
                                                           Text="{Binding OverCount, FallbackValue=0}" />
                                                <ProgressBar Grid.Column="6"
                                                             Margin="24,0,0,0"
                                                             VerticalAlignment="Center"
                                                             Style="{StaticResource HistoryBarStyle}"
                                                             Value="{Binding PeakRatio, Mode=OneWay, FallbackValue=0}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!--  采样明细  -->
                        <Grid Grid.Row="6" RowDefinitions="Auto,6,Auto,4,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource HistoryTitleStyle}" Text="采样明细" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource HistoryHintStyle}"
                                           Text="1 秒一条 · 滚轮查看" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Height="26"
                                    Background="{StaticResource HistoryHeaderBrush}"
                                    CornerRadius="{StaticResource RadiusXs}">
                                <Grid Margin="12,0" ColumnDefinitions="92,*,*,*,*,*,*,*,*">
                                    <TextBlock Style="{StaticResource HistoryHeaderStyle}" Text="时间" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="轨顶 ℃" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="轨脚 ℃" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="内轨脚 ℃" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="冷却 ℃" />
                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="压力 MPa" />
                                    <TextBlock Grid.Column="6"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="轨顶 L/min" />
                                    <TextBlock Grid.Column="7"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="轨腰 L/min" />
                                    <TextBlock Grid.Column="8"
                                               Style="{StaticResource HistoryHeaderRightStyle}"
                                               Text="轨底 L/min" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="4"
                                     ItemsSource="{Binding SelectedRecord.Samples}"
                                     Style="{StaticResource HistorySampleListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28" ColumnDefinitions="92,*,*,*,*,*,*,*,*">
                                            <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Style="{StaticResource HistoryCellStyle}"
                                                       Text="{Binding Time, FallbackValue='—'}" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Temp1}" />
                                            <TextBlock Grid.Column="2"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Temp2}" />
                                            <TextBlock Grid.Column="3"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Temp3}" />
                                            <TextBlock Grid.Column="4"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Temp4}" />
                                            <TextBlock Grid.Column="5"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Pressure}" />
                                            <TextBlock Grid.Column="6"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Flow1}" />
                                            <TextBlock Grid.Column="7"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Flow2}" />
                                            <TextBlock Grid.Column="8"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Style="{StaticResource HistoryCellRightStyle}"
                                                       Text="{Binding Flow3}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!--  未选择焊缝时的空状态  -->
                        <Border Grid.RowSpan="7"
                                Panel.ZIndex="5"
                                Background="{StaticResource SurfaceCardBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecord}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel MaxWidth="440"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="58"
                                        Height="58"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource AccentTint50Brush}"
                                        CornerRadius="16">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="24"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="&#xE81C;" />
                                </Border>
                                <TextBlock Margin="0,18,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource UiFontSemibold}"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="选择左侧记录，查看完整记录" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="指标统计、峰值占比与逐秒采样都会显示在这里；也可以直接搜索账户。"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />

                                <StackPanel Margin="0,20,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Border Padding="10,5"
                                            Background="{StaticResource SurfaceSubtleBrush}"
                                            CornerRadius="{StaticResource RadiusSm}">
                                        <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="指标统计" />
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            Padding="10,5"
                                            Background="{StaticResource SurfaceSubtleBrush}"
                                            CornerRadius="{StaticResource RadiusSm}">
                                        <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="峰值占比" />
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            Padding="10,5"
                                            Background="{StaticResource SurfaceSubtleBrush}"
                                            CornerRadius="{StaticResource RadiusSm}">
                                        <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="逐秒采样" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:PageFooter Grid.Row="1" />
    </Grid>
</UserControl>

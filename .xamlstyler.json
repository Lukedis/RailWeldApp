    "MinHeight",
    "MaxWidth",
    "MaxHeight",
    "Margin",
    "Padding",
    "HorizontalAlignment",
    "VerticalAlignment",
    "Grid.Row",
    "Grid.Column",
    "Grid.RowSpan",
    "Grid.ColumnSpan",
    "Panel.ZIndex",
    "Style",
    "Background",
    "Foreground",
    "BorderBrush",
    "BorderThickness",
    "FontFamily",
    "FontSize",
    "FontWeight",
    "Text",
    "Content",
    "Command",
    "IsEnabled",
    "IsChecked",
    "IsDefault"

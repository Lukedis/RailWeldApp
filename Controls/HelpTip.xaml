<UserControl x:Class="RailWeldApp.Controls.HelpTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Self"
             d:DesignHeight="18"
             d:DesignWidth="18"
             AutomationProperties.HelpText="{Binding Text, ElementName=Self}"
             AutomationProperties.Name="帮助提示"
             Cursor="Hand"
             Focusable="False"
             ToolTipService.InitialShowDelay="250"
             ToolTipService.ShowDuration="20000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="HelpTipToolTipStyle" TargetType="ToolTip">
            <Setter Property="Placement" Value="Top" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Grid Margin="10">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Direction="270"
                                                  Opacity="0.14"
                                                  RenderingBias="Performance"
                                                  ShadowDepth="2"
                                                  Color="#000000" />
                            </Grid.Effect>

                            <Border MaxWidth="300"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceCardBrush}"
                                    CornerRadius="10">
                                <ContentPresenter />
                            </Border>

                            <!--  向下的气泡尖角，配合 Placement=Top  -->
                            <!--<Path Grid.Row="1"
                                  Width="18"
                                  Height="9"
                                  HorizontalAlignment="Center"
                                  Data="M0,0 L9,9 L18,0 Z"
                                  Fill="{StaticResource SurfaceCardBrush}"
                                  Stretch="Fill"
                                  Stroke="{StaticResource TextTertiaryBrush}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1" />-->
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpTipToolTipTextStyle" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="Mark"
            Width="18"
            Height="18"
            CornerRadius="9"
            SnapsToDevicePixels="True"
            Tag="{Binding Text, ElementName=Self}"
            ToolTipService.InitialShowDelay="250"
            ToolTipService.ShowDuration="20000">
        <Border.ToolTip>
            <ToolTip Style="{StaticResource HelpTipToolTipStyle}">
                <TextBlock Style="{StaticResource HelpTipToolTipTextStyle}" Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}" />
            </ToolTip>
        </Border.ToolTip>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentTint100Brush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="12"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   Text="&#xE897;" />
    </Border>
</UserControl>

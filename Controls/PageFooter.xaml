<UserControl x:Class="RailWeldApp.Controls.PageFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="46"
             d:DesignWidth="1200"
             mc:Ignorable="d">

    <!-- 纯装饰页脚，不绑任何 VM 属性 -->
    <Border Height="46"
            Background="Transparent"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
        <Grid Margin="64,0" ColumnDefinitions="Auto,*,Auto">

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Border Width="18"
                        Height="18"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="5">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFontSemibold}"
                               FontSize="10"
                               Foreground="White"
                               Text="R" />
                </Border>
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFontSemibold}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="RailWeld" />
                <Border Width="1"
                        Height="12"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource DividerBrush}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="全自动钢轨焊接接头热处理控制台" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Ellipse Width="3" Height="3" Fill="{StaticResource AccentBrush}" />
                <Border Width="28"
                        Height="1"
                        Margin="8,0"
                        Background="{StaticResource DividerBrush}" />
                <Ellipse Width="3" Height="3" Fill="{StaticResource TextTertiaryBrush}" />
                <Border Width="28"
                        Height="1"
                        Margin="8,0"
                        Background="{StaticResource DividerBrush}" />
                <Ellipse Width="3" Height="3" Fill="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFontMedium}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="INDUSTRIAL · PRECISION · STABLE" />
                <Border Width="1"
                        Height="12"
                        Margin="14,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource DividerBrush}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="© 2026" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

{
    "Database": {
        "Path": "%LocalAppData%\\RailWeldApp\\RailWeld.db"
    },
    "PLC": {
        "Ip": "127.0.0.1",
        "Port": 102,
        "CpuType": "S7300",
        "Rack": 0,
        "Slot": 2,
        "ReadTimeout": 2000,
        "WriteTimeout": 2000,
        "HeartbeatInterval": 2000,
        "HeartbeatFailureThreshold": 3,
        "HeartbeatDbNumber": 3,
        "HeartbeatStartByte": 0,
        "HeartbeatByteCount": 1
    },
    "ModbusRTU": {
        "PortName": "COM8",
        "BaudRate": 9600,
        "DataBits": 8,
        "Parity": "Even",
        "StopBits": "One",
        "ReadTimeout": 1000,
        "WriteTimeout": 1000,
        "SlaveAddress": 1,
        "VerificationRegisterAddress": 0
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/railweld-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "shared": true,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    }
}
